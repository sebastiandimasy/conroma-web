---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const links = [
  { label: 'Inicio', href: '/es/' },
  { label: 'Pisos en venta en Malgrat de Mar', href: '/es/venta/malgrat-de-mar/' },
  { label: '¿Cuánto vale mi piso?', href: '/es/valoracion/' },
  { label: 'Contacto', href: '/es/contacto/' },
];
---

<BaseLayout title="Página no encontrada" description="Esta página no existe o ha cambiado de sitio." path="/404/" noindex>
  <section class="page-head page-head--editorial">
    <div class="wrap">
      <h1 class="page-head__title">Vaya, esta página no está</h1>
      <p class="page-head__lead">Puede que el piso ya se haya vendido o que el enlace esté mal. Prueba por aquí.</p>
      <nav class="town-list error-links" aria-label="Otras páginas">
        <ul class="town-list__items">
          {
            links.map((link) => (
              <li>
                <a class="town-list__link" href={link.href}>
                  <span>{link.label}</span>
                  <Icon name="arrow" class="town-links__arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .error-links {
    margin-top: var(--space-8);
  }
</style>
