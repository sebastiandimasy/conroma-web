---
import { getLang, languages, localizePath, strings } from '../../../i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import PropertyGallery from '../../../islands/PropertyGallery';
import FavoriteToggle from '../../../islands/FavoriteToggle';
import PropertyGrid from '../../../islands/PropertyGrid';
import ApproxLocationMap from '../../../islands/ApproxLocationMap';
import { cardFacts, countLabel, forCard, getListings, hasPublicPrice, isHome, propertyDocTitle, propertySlug, propertyTitle, stateLabel, type Property, typeLabel } from '../../../data/properties';
import { findTown, publishedCatalogTowns } from '../../../data/towns';
import { site } from '../../../data/site';
import { formatFloor, formatPrice } from '../../../lib/format';
import { phoneUrl, whatsappUrl } from '../../../lib/links';
import { isNewListing } from '../../../lib/inventory';
import { breadcrumbSchema, listingSchema } from '../../../lib/seo';

export function getStaticPaths() {
  return languages.flatMap((lang) => getListings().map((property) => ({ params: { lang, slug: propertySlug(property) }, props: { property } })));
}

interface Props {
  property: Property;
}

const { property } = Astro.props;
const lang = getLang(Astro.url);
const t = strings({
  es: {
    home: 'Inicio',
    forSaleIn: (town: string) => `Inmuebles en venta en ${town}`,
    typeIn: (type: string, zone: string) => `${type} en ${zone}`,
    priceFor: (price: string) => ` por ${price}`,
    visit: 'Pedir visita',
    isNew: 'Nuevo',
    askPrice: 'Precio a consultar',
    drop: (before: string, drop: string) => `Antes ${before} · ha bajado ${drop}`,
    afford: '¿Me lo puedo permitir? Calcúlalo',
    plain: 'Te lo contamos fácil',
    inSpanish: '',
    likes: 'Lo que más nos gusta',
    watchOut: 'A tener en cuenta',
    features: 'Características',
    type: 'Tipo',
    state: 'Estado',
    floor: 'Planta',
    lift: 'Ascensor',
    parking: 'Parking',
    terrace: 'Terraza o balcón',
    emissions: 'Emisiones de CO₂',
    consumption: 'Consumo de energía',
    perYear: 'año',
    certificate: 'Certificado energético',
    exempt: 'Exento',
    pending: 'En trámite',
    reference: 'Referencia',
    yes: 'Sí',
    ask: 'Consultar',
    area: 'La zona',
    areaText: (place: string) => `${place}. En el mapa te situamos la zona aproximada; la dirección exacta te la contamos cuando hablemos.`,
    areaNav: 'Zona',
    moreIn: (town: string) => `Más pisos en venta en ${town}`,
    agent: 'Conoce este piso por dentro',
    call: 'Llamar',
    similar: 'Viviendas parecidas',
  },
  en: {
    home: 'Home',
    forSaleIn: (town: string) => `Properties for sale in ${town}`,
    typeIn: (type: string, zone: string) => `${type} in ${zone}`,
    priceFor: (price: string) => ` for ${price}`,
    visit: 'Book a viewing',
    isNew: 'New',
    askPrice: 'Price on request',
    drop: (before: string, drop: string) => `Was ${before} · down ${drop}`,
    afford: 'Can I afford it? Work it out',
    plain: 'In a nutshell',
    inSpanish: 'Description in Spanish.',
    likes: 'What we like most',
    watchOut: 'Worth knowing',
    features: 'Features',
    type: 'Type',
    state: 'Condition',
    floor: 'Floor',
    lift: 'Lift',
    parking: 'Parking',
    terrace: 'Terrace or balcony',
    emissions: 'CO₂ emissions',
    consumption: 'Energy consumption',
    perYear: 'per year',
    certificate: 'Energy certificate (EPC)',
    exempt: 'Exempt',
    pending: 'In progress',
    reference: 'Reference',
    yes: 'Yes',
    ask: 'Ask us',
    area: 'The area',
    areaText: (place: string) => `${place}. The map shows the rough area; we'll give you the exact address when we talk.`,
    areaNav: 'Area',
    moreIn: (town: string) => `More homes for sale in ${town}`,
    agent: 'Knows this property inside out',
    call: 'Call',
    similar: 'Similar homes',
  },
  ca: {
    home: 'Inici',
    forSaleIn: (town: string) => `Immobles en venda a ${town}`,
    typeIn: (type: string, zone: string) => `${type} a ${zone}`,
    priceFor: (price: string) => ` per ${price}`,
    visit: 'Demana una visita',
    isNew: 'Nou',
    askPrice: 'Preu a consultar',
    drop: (before: string, drop: string) => `Abans ${before} · ha baixat ${drop}`,
    afford: "M'ho puc permetre? Calcula-ho",
    plain: "T'ho expliquem fàcil",
    inSpanish: '',
    likes: 'El que més ens agrada',
    watchOut: 'A tenir en compte',
    features: 'Característiques',
    type: 'Tipus',
    state: 'Estat',
    floor: 'Planta',
    lift: 'Ascensor',
    parking: 'Pàrquing',
    terrace: 'Terrassa o balcó',
    emissions: 'Emissions de CO₂',
    consumption: "Consum d'energia",
    perYear: 'any',
    certificate: 'Certificat energètic',
    exempt: 'Exempt',
    pending: 'En tràmit',
    reference: 'Referència',
    yes: 'Sí',
    ask: "Pregunta'ns",
    area: 'La zona',
    areaText: (place: string) => `${place}. Al mapa et situem la zona aproximada; l'adreça exacta te la diem quan parlem.`,
    areaNav: 'Zona',
    moreIn: (town: string) => `Més pisos en venda a ${town}`,
    agent: 'Coneix aquest pis per dins',
    call: 'Trucar',
    similar: 'Habitatges semblants',
  },
})[lang];
const town = findTown(property.town);
const townName = town?.name ?? property.town;
// Coords reales del piso (feed) si las hay; si no, el centro del pueblo.
const mapGeo = property.geo ?? town?.geo ?? null;
const title = propertyTitle(property, lang);
const docTitle = propertyDocTitle(property, getListings(), lang);
const type = typeLabel(property.type, lang);
// Terrenos, locales y parkings no tienen habitaciones: fuera el «0 habitaciones, 0 baños».
const summary = isHome(property)
  ? `${countLabel(property.rooms, 'room', lang)}, ${countLabel(property.baths, 'bath', lang)}, ${property.area} m²`
  : `${property.area} m²`;
// La descripción de Habitatsoft viene en español. Si el feed la trae en el idioma de la página, esa;
// si no, la española marcada con lang="es" (no se traduce a mano).
const ownDescription = lang === 'es' ? property.description : property.descriptions?.[lang];
const description = ownDescription || property.description;
const descriptionLang = ownDescription ? undefined : 'es';
const path = `/es/inmueble/${propertySlug(property)}/`;
// Si el pueblo no tiene página de catálogo (pueblo fino, fuera del índice), enlaza al listado general.
const listingPath = publishedCatalogTowns.some((t) => t.slug === property.town)
  ? `/es/venta/${property.town}/`
  : '/es/venta/';
const drop = property.previousPrice ? property.previousPrice - property.price : 0;
const crumbs = [
  { name: t.home, path: '/es/' },
  { name: t.forSaleIn(townName), path: listingPath },
  { name: t.typeIn(type, property.zone), path },
];
const similar = getListings({ town: property.town, operation: property.operation })
  .filter((item) => item.ref !== property.ref)
  .sort((a, b) => Math.abs(a.price - property.price) - Math.abs(b.price - property.price))
  .slice(0, 3);
// Una ficha sin fotos no merece estar en Google: se queda fuera aunque la cartera
// ya sea indexable (hoy son 8 de 126).
const hasPhotos = Boolean(property.images && property.images.length > 0);
const indexable = site.catalogIndexable && hasPhotos;
// «Zona, pueblo» sin repetir cuando la zona es el propio pueblo (Malgrat de Mar, Malgrat de Mar).
const place = property.zone && property.zone !== townName ? `${property.zone}, ${townName}` : townName;
const home = isHome(property);
// La planta y el ascensor solo dicen algo en pisos; en una casa, «planta baja» confunde.
const flat = /piso|ático|dúplex|estudio|apartamento|bungalow|loft/i.test(property.type);
// Datos de cabecera sin ceros (terrenos, locales y parkings no tienen habitaciones ni planta).
const facts = flat ? [...cardFacts(property, lang), formatFloor(property.floor, lang)] : cardFacts(property, lang);
const features = [
  { label: t.type, value: type },
  { label: t.state, value: stateLabel(property.state, lang) },
  ...(flat
    ? [
        { label: t.floor, value: formatFloor(property.floor, lang) },
        { label: t.lift, value: property.elevator ? t.yes : t.ask },
      ]
    : []),
  ...(home
    ? [
        { label: t.parking, value: property.parking ? t.yes : t.ask },
        { label: t.terrace, value: property.terrace ? t.yes : t.ask },
      ]
    : []),
  // Obligatorio en la publicidad (RD 390/2021). Hoy sale de la web antigua; mañana, del feed.
  ...(property.energyRating
    ? [
        {
          label: t.emissions,
          value: `${property.energyRating}${property.energyEmissions ? ` · ${property.energyEmissions} kg/m² ${t.perYear}` : ''}`,
        },
        ...(property.energyConsumptionRating
          ? [
              {
                label: t.consumption,
                value: `${property.energyConsumptionRating}${property.energyConsumption ? ` · ${property.energyConsumption} kWh/m² ${t.perYear}` : ''}`,
              },
            ]
          : []),
      ]
    : property.energyExempt || property.energyPending
      ? [{ label: t.certificate, value: property.energyExempt ? t.exempt : t.pending }]
      : []),
  { label: t.reference, value: property.ref },
];
// En en/ca la meta description no lleva la descripción española: solo el resumen, o la suya si existe.
const metaDescription = `${title}${hasPublicPrice(property) ? t.priceFor(formatPrice(property.price, lang)) : ''}: ${summary}. Ref. ${property.ref}. ${ownDescription ?? ''}`.trim();
---

<BaseLayout
  title={docTitle}
  description={metaDescription}
  path={path}
  schemas={[breadcrumbSchema(crumbs, lang), listingSchema(property, lang)]}
  contact={{ propertyRef: property.ref, propertyTitle: title }}
  primaryAction={{ label: t.visit, href: '#contacto' }}
  noindex={!indexable}
>
  <article class="property">
    <div class="wrap property__top">
      <Breadcrumbs crumbs={crumbs} />
    </div>

    <div class="wrap property__layout">
      <div class="property__main">
        <header class="property__summary">
          <h1 class="property__title">{title}</h1>
          <p class="property__place">{isNewListing(property) && <span class="tag-new">{t.isNew}</span>}{place} · Ref. {property.ref}</p>
          <div class="property__price-row">
            <p class="property__price">
              {
                hasPublicPrice(property) ? (
                  <data value={property.price}>{formatPrice(property.price, lang)}</data>
                ) : (
                  <span class="property-card__price--ask">{t.askPrice}</span>
                )
              }
            </p>
            <div class="property__save">
              <FavoriteToggle client:load propertyRef={property.ref} label lang={lang} />
            </div>
          </div>
          {
            drop > 0 && property.previousPrice && (
              <p class="property__drop">
                {t.drop(formatPrice(property.previousPrice, lang), formatPrice(drop, lang))}
              </p>
            )
          }
        </header>

        <div class="property__gallery">
          <PropertyGallery client:load propertyRef={property.ref} title={title} photos={property.photos} tone={property.tone} images={property.images} lang={lang} />
        </div>

        <div class="property__overview">
          {facts.length > 0 && (
            <ul class="property__facts">
              {facts.map((fact) => <li>{fact}</li>)}
            </ul>
          )}
          {
            hasPublicPrice(property) && (
              <a class="link-cta property__mortgage" href={localizePath(`/es/comprar/puedo-comprar/?precio=${property.price}`, lang)}>
                {t.afford}
              </a>
            )
          }
        </div>

        {
          (description || property.likes || property.watchOut) && (
            <section class="property__block" id="resumen">
              <h2 class="property__heading">{t.plain}</h2>
              {description && <p class="property__description" lang={descriptionLang}>{description}</p>}
              {description && descriptionLang && t.inSpanish && <p class="property__lang-note">{t.inSpanish}</p>}
              {
                (property.likes || property.watchOut) && (
              <div class="honesty">
                {property.likes && (
                  <div class="honesty__item">
                    <h3 class="honesty__title">{t.likes}</h3>
                    <p lang={lang === 'es' ? undefined : 'es'}>{property.likes}</p>
                  </div>
                )}
                {property.watchOut && (
                  <div class="honesty__item">
                    <h3 class="honesty__title">{t.watchOut}</h3>
                    <p lang={lang === 'es' ? undefined : 'es'}>{property.watchOut}</p>
                  </div>
                )}
              </div>
            )
          }
            </section>
          )
        }

        <section class="property__block" id="caracteristicas">
          <h2 class="property__heading">{t.features}</h2>
          <dl class="spec-list">
            {
              features.map((feature) => (
                <div class="spec-list__row">
                  <dt>{feature.label}</dt>
                  <dd>{feature.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="property__block" id="zona">
          <h2 class="property__heading">{t.area}</h2>
          <p class="property__description">
            {t.areaText(place)}
          </p>
          {
            mapGeo && (
              <div class="property__map">
                <ApproxLocationMap
                  client:visible
                  latitude={mapGeo.latitude}
                  longitude={mapGeo.longitude}
                  label={`${property.zone}, ${townName}`}
                  lang={lang}
                />
              </div>
            )
          }
          <nav class="link-list" aria-label={t.areaNav}>
            <a class="link-list__link" href={localizePath(listingPath, lang)}>
              {t.moreIn(townName)}
              <Icon name="arrow" class="link-list__arrow" />
            </a>
          </nav>
        </section>
      </div>

      <aside class="property__aside" id="contacto">
        <div class="contact-card">
          <h2 class="property__heading">{t.visit}</h2>
          {
            site.agent && (
              <div class="agent">
                <img class="agent__photo" src={site.agent.photo} alt={site.agent.name} width="64" height="64" loading="lazy" />
                <p>
                  <strong>{site.agent.name}</strong>
                  <br />
                  {t.agent}
                </p>
              </div>
            )
          }
          <div class="contact-card__actions">
            <a
              class="button button--ink button--block"
              href={whatsappUrl(lang, { reason: 'visita', propertyRef: property.ref, propertyTitle: title })}
              data-contact="whatsapp"
              data-origin="ficha-contacto"
              data-ref={property.ref}
            >
              <Icon name="whatsapp" class="button__icon" />
              WhatsApp
            </a>
            <a class="button button--ghost button--block" href={phoneUrl()} data-contact="llamada" data-origin="ficha-contacto" data-ref={property.ref}>
              <Icon name="phone" class="button__icon" />
              {t.call}
            </a>
          </div>
        </div>
      </aside>
    </div>

    {
      similar.length > 0 && (
        <section class="section similar">
          <div class="wrap">
            <div class="section__head">
              <h2 class="section__title">{t.similar}</h2>
            </div>
            <PropertyGrid client:visible properties={similar.map(forCard)} townName={townName} origin="ficha-parecidas" lang={lang} />
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
