---
import { getLang, langPaths } from '../../i18n';

export const getStaticPaths = langPaths;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import SavedProperties from '../../islands/SavedProperties';
import { getListings } from '../../data/properties';
import { breadcrumbSchema } from '../../lib/seo';

const path = '/es/guardados/';
// Solo lo que pinta la tarjeta: sin descripciones ni galerías completas (el HTML pasaba de 850 KB).
const slim = getListings().map(({ description, likes, watchOut, geo, images, ...p }) => ({
  ...p,
  description: '',
  likes: '',
  watchOut: '',
  images: images?.slice(0, 1),
}));
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Guardados', path },
];
const lang = getLang(Astro.url);
---

<BaseLayout
  title="Tus pisos guardados | Conroma"
  description="Los pisos que has guardado en Conroma Asesores, para compararlos con calma o enseñárselos a quien decida contigo."
  path={path}
  noindex
  schemas={[breadcrumbSchema(crumbs)]}
>
  <section class="page-head page-head--editorial">
    <div class="wrap">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="page-head__title" data-split>Tus pisos guardados</h1>
      <p class="page-head__lead">
        Se guardan en este navegador, sin registrarte. Si cambias de móvil o de ordenador, no viajan contigo.
      </p>
    </div>
  </section>

  <section class="section saved-section">
    <div class="wrap">
      <SavedProperties client:load properties={slim} listingUrl="/es/venta/" />
    </div>
  </section>

  <ClosingCTA title="Hablemos" titleMuted="de los que te gustan" origin="guardados-cierre" reason="visita" />
</BaseLayout>
