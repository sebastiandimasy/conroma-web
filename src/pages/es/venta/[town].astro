---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import Faq from '../../../components/Faq.astro';
import ListingExplorer from '../../../islands/ListingExplorer';
import { cheapestPrice, homesIn, propertiesIn, typeBreakdown } from '../../../data/properties';
import { publishedCatalogTowns, type Town } from '../../../data/towns';
import { formatPrice } from '../../../lib/format';
import { breadcrumbSchema, collectionPageSchema, faqSchema } from '../../../lib/seo';
import { whatsappUrl } from '../../../lib/links';
import { site } from '../../../data/site';

export function getStaticPaths() {
  return publishedCatalogTowns.map((town) => ({ params: { town: town.slug }, props: { town } }));
}

interface Props {
  town: Town;
}

const { town } = Astro.props;
const path = `/es/venta/${town.slug}/`;
const catalog = propertiesIn(town.slug, 'venta');
const homes = homesIn(town.slug, 'venta');
const cheapest = cheapestPrice(catalog);
const breakdown = typeBreakdown(catalog);
// En algunos pueblos la cartera es casi toda local, terreno o parking. El titular
// no puede prometer "pisos" cuando solo hay uno: se nombra lo que de verdad hay.
const mostlyHomes = homes.length >= Math.max(3, catalog.length / 2);
const heading = mostlyHomes ? `Pisos y casas en venta en ${town.name}` : `Inmuebles en venta en ${town.name}`;
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: heading, path },
];
const faq = [
  {
    question: `¿Cuántos pisos tenéis en venta en ${town.name}?`,
    answer:
      homes.length > 0
        ? `Ahora mismo, ${homes.length} ${homes.length === 1 ? 'vivienda' : 'viviendas'} de un total de ${catalog.length} inmuebles (${breakdown}). La lista cambia cada semana, así que si no ves el tuyo, dinos qué buscas y te avisamos.`
        : `Ahora mismo no tenemos vivienda en ${town.name}: los ${catalog.length} inmuebles publicados son ${breakdown}. Dinos qué buscas y te avisamos en cuanto entre algo.`,
  },
  {
    question: `¿Cómo visito un piso en ${town.name}?`,
    answer: 'Escríbenos por WhatsApp desde la ficha del piso, o llámanos. Cuadramos día y hora y te lo enseñamos.',
  },
];
---

<BaseLayout
  title={heading}
  description={`${catalog.length} inmuebles en venta en ${town.name}${cheapest ? ` desde ${formatPrice(cheapest)}` : ''}: ${breakdown}. Con el precio a la vista y contacto directo por WhatsApp.`}
  path={path}
  schemas={[breadcrumbSchema(crumbs), collectionPageSchema(heading, path), faqSchema(faq)]}
  noindex={!site.catalogIndexable}
>
  <section class="page-head">
    <div class="wrap">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="page-head__title" data-split>{heading}</h1>
      <p class="page-head__lead">{catalog.length} inmuebles publicados: {breakdown}.</p>
    </div>
  </section>

  <section class="listing-section">
    <div class="wrap">
      <ListingExplorer client:load properties={catalog} townName={town.name} />
      <aside class="alert-card" data-reveal>
        <span class="alert-card__corner alert-card__corner--tl" aria-hidden="true"><Icon name="plus" /></span>
        <span class="alert-card__corner alert-card__corner--tr" aria-hidden="true"><Icon name="plus" /></span>
        <span class="alert-card__corner alert-card__corner--bl" aria-hidden="true"><Icon name="plus" /></span>
        <span class="alert-card__corner alert-card__corner--br" aria-hidden="true"><Icon name="plus" /></span>
        <div class="alert-card__text">
          <p class="alert-card__eyebrow">Búsqueda a medida</p>
          <h2 class="alert-card__title">¿No ves el tuyo?</h2>
          <p class="alert-card__lead">Dinos qué buscas y te avisamos cuando entre algo así, o si alguno baja de precio.</p>
        </div>
        <a class="button button--ink button--large alert-card__cta" href={whatsappUrl({ reason: 'general' })} data-contact="whatsapp" data-origin="listado-aviso">
          <Icon name="whatsapp" class="button__icon" />
          Avisadme por WhatsApp
        </a>
      </aside>
    </div>
  </section>

  <section class="section town-text">
    <div class="wrap town-text__grid">
      <div data-reveal>
        <h2 class="section__title">Comprar piso en {town.name}</h2>
        <p class="section__lead">{town.intro}</p>
      </div>
      <div data-reveal>
        <nav class="link-list" aria-label="Relacionados">
          <a class="link-list__link" href="/es/valoracion/">
            ¿Vendes en {town.name}? Mira cuánto vale
            <Icon name="arrow" class="link-list__arrow" />
          </a>
          <a class="link-list__link" href="/es/inmobiliaria/blanes/">
            Inmobiliaria en Blanes
            <Icon name="arrow" class="link-list__arrow" />
          </a>
        </nav>
        <Faq items={faq} name="pueblo" />
      </div>
    </div>
  </section>
</BaseLayout>
