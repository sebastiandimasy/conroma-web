---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Statement from '../../components/sections/Statement.astro';
import TeamMembers from '../../components/sections/TeamMembers.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import ReelRow from '../../components/sections/ReelRow.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import closingPhoto from '../../assets/equipo/conroma-91.jpg';
import { breadcrumbSchema, teamSchema } from '../../lib/seo';

const path = '/es/equipo/';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Nuestro equipo', path },
];
---

<BaseLayout
  title="Nuestro equipo: las personas de Conroma"
  description="Conoce al equipo de Conroma Asesores en Malgrat de Mar: quién te atiende, quién enseña los pisos y quién te acompaña a notaría."
  path={path}
  schemas={[breadcrumbSchema(crumbs), ...teamSchema()]}
>
  <section class="page-head page-head--editorial">
    <div class="wrap">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="page-head__title" data-split>El equipo de Conroma en Malgrat de Mar</h1>
      <p class="page-head__lead">
        Quien te atiende el primer día te acompaña hasta la firma. Nada de empezar con alguien y acabar con otro.
      </p>
    </div>
  </section>

  <Statement
    text="Somos especialistas en gestión inmobiliaria y líderes en gestión de patrimonios. Te asesoramos de forma totalmente personalizada, buscando que cada parte salga ganando, y siempre con una atención cercana."
  />

  <TeamMembers title="Quién te atiende">
    <a class="arrow-link team-members__more" href="/es/empresa/">
      <span class="arrow-link__icon" aria-hidden="true"><Icon name="arrow" /></span>
      <span class="arrow-link__label">Conoce la empresa y a su fundador</span>
    </a>
  </TeamMembers>

  <Testimonials />

  <ReelRow title="Historias de clientes" lead="Casos reales que hemos acompañado, contados en vídeo." />

  <ClosingCTA title="Hablemos" titleMuted="con el equipo" image={closingPhoto} origin="equipo-cierre" />
</BaseLayout>
