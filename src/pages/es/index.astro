---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import HeroStory from '../../components/sections/HeroStory.astro';
import Statement from '../../components/sections/Statement.astro';
import ProofBand from '../../components/sections/ProofBand.astro';
import ServiceIndex from '../../components/sections/ServiceIndex.astro';
import SplitFeature from '../../components/sections/SplitFeature.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import PropertyGrid from '../../islands/PropertyGrid';
import teamPhoto from '../../assets/equipo/equipo.jpg';
import reformPhoto from '../../assets/reformas/reforma-10.jpg';
import closingPhoto from '../../assets/equipo/conroma-102.jpg';
import { homeFaq } from '../../data/faq';
import { site } from '../../data/site';
import { getListings, homesIn, propertiesIn } from '../../data/properties';
import { publishedCatalogTowns } from '../../data/towns';
import { formatRating } from '../../lib/format';
import { faqSchema } from '../../lib/seo';

const rating = site.googleRating;
// Foto de portada del equipo (site.ts): la agencia es la gente que te atiende.
const hero = site.heroImage!;

// Destacados: pisos reales de Malgrat (hasta 3), como en /es/comprar/.
const featuredHomes = homesIn('malgrat-de-mar', 'venta').slice(0, 3);
const ventaTotal = getListings({ operation: 'venta' }).length;

// Pueblos con cartera, de más a menos inmuebles: enlaces directos a cada listado (un toque en
// móvil y enlaces internos que Google sigue, en lugar del buscador de tres pasos).
const townRows = publishedCatalogTowns
  .map((town) => ({ slug: town.slug, name: town.name, total: propertiesIn(town.slug, 'venta').length }))
  .filter((town) => town.total > 0)
  .sort((a, b) => b.total - a.total);

const answer =
  'Conroma Asesores es una inmobiliaria familiar con oficina en Malgrat de Mar. Trabajamos en el Alt Maresme y La Selva, ' +
  'y la misma persona te atiende del primer contacto a la firma, en catalán, castellano, inglés y francés.';
---

<BaseLayout
  title="Inmobiliaria en Malgrat de Mar | Conroma"
  description="Inmobiliaria en Malgrat de Mar: compra, venta, alquiler, patrimonio y reformas en el Alt Maresme. Te atendemos en catalán, castellano, inglés y francés."
  path="/es/"
  schemas={[faqSchema(homeFaq)]}
  overlay
>
  <HeroStory
    title="Inmobiliaria en Malgrat de Mar"
    lead="Compramos, vendemos y alquilamos contigo. Y nos quedamos para lo que venga después."
    image={hero.src}
    alt={hero.alt}
    cta={{ label: `Ver los ${ventaTotal} inmuebles en venta`, href: '/es/venta/' }}
    position="40% center"
  />

  <Statement text={answer} />

  <ProofBand />

  <section class="section home-featured">
    <div class="wrap">
      {
        featuredHomes.length > 0 && (
          <>
            <h2 class="section__title" data-reveal>Pisos en venta en Malgrat de Mar</h2>
            <div class="home-featured__grid">
              <PropertyGrid client:visible properties={featuredHomes} townName="Malgrat de Mar" origin="home-destacados" />
            </div>
          </>
        )
      }
      <div class="home-featured__towns" data-reveal>
        <h3 class="home-featured__towns-title">Busca en tu pueblo</h3>
        <ul class="home-featured__town-list">
          {
            townRows.map((town) => (
              <li>
                <a class="home-featured__town" href={`/es/venta/${town.slug}/`}>
                  <span>{town.name}</span>
                  <span class="home-featured__count">
                    {town.total} {town.total === 1 ? 'inmueble' : 'inmuebles'}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <a class="arrow-link home-featured__more" href="/es/venta/">
        <span class="arrow-link__icon" aria-hidden="true"><Icon name="arrow" /></span>
        <span class="arrow-link__label">Ver los {ventaTotal} inmuebles en venta</span>
      </a>
    </div>
  </section>

  <ServiceIndex title="Qué hacemos por ti" />

  <SplitFeature
    title="Somos una familia de aquí"
    text="La misma persona te atiende el primer día y te acompaña hasta la firma, y seguimos a tu lado para lo que venga después. Consultores inmobiliarios, gestores de patrimonio y asesores jurídicos."
    image={teamPhoto}
    alt="El equipo de Conroma Asesores en la oficina de Malgrat de Mar"
    link={{ label: 'Conoce al equipo', href: '/es/equipo/' }}
  />

  <SplitFeature
    title="Le damos una segunda vida al piso"
    text="Conroma en Obras reforma y viste la vivienda antes de venderla o de que entres a vivir. De la cocina al último detalle, lo dejamos listo."
    image={reformPhoto}
    alt="Salón reformado por Conroma en Obras"
    link={{ label: 'Ver reformas e interiorismo', href: '/es/reformas/' }}
    reverse
    tone="canvas"
  />

  <FaqSection title="Dudas al comprar o vender en el Maresme" items={homeFaq} origin="home-faq" />

  <section class="section reviews" aria-label="Reseñas de clientes en Google" data-reviews>
    <div class="wrap">
      {
        rating && (
          <a class="reviews__fallback" href={rating.url} rel="noopener" target="_blank" data-reviews-fallback>
            <span class="reviews__stars" role="img" aria-label={`${formatRating(rating.value)} sobre 5 en Google`}>
              <Icon name="star" class="reviews__star" />
              <Icon name="star" class="reviews__star" />
              <Icon name="star" class="reviews__star" />
              <Icon name="star" class="reviews__star" />
              <Icon name="star" class="reviews__star" />
            </span>
            <span class="reviews__text">
              <strong>{formatRating(rating.value)} en Google</strong> · {rating.count} reseñas de clientes · Verlas todas
            </span>
          </a>
        )
      }
      {/* Widget Trustindex: reseñas de Google en vivo. Es un tercero que deja cookies,
          así que solo se carga si el visitante ha aceptado. Mientras tanto se queda el
          resumen propio de arriba, que lleva la cifra con fecha de comprobación. */}
      <div data-reviews-widget></div>
    </div>
    <script is:inline>
      (function () {
        var sec = document.currentScript.closest('[data-reviews]');
        if (!sec) return;
        var fb = sec.querySelector('[data-reviews-fallback]');
        var slot = sec.querySelector('[data-reviews-widget]');
        if (!slot) return;
        var loaded = false;

        function load() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.defer = true;
          s.async = true;
          s.src = 'https://cdn.trustindex.io/loader.js?d045063849cb67522f863d5cb82';
          slot.appendChild(s);
          // El resumen propio solo se retira cuando el widget pinta algo de verdad:
          // si no llega a cargar, el visitante sigue viendo la nota y las reseñas.
          if (!fb) return;
          var obs = new MutationObserver(function () {
            if (slot.querySelector('div, iframe')) {
              fb.style.display = 'none';
              obs.disconnect();
            }
          });
          obs.observe(slot, { childList: true, subtree: true });
          setTimeout(function () { obs.disconnect(); }, 15000);
        }

        try {
          if (localStorage.getItem('conroma:cookies') === 'aceptado') load();
        } catch (e) {}
        window.addEventListener('conroma:consent', function (event) {
          if (event.detail === 'aceptado') load();
        });
      })();
    </script>
  </section>

  <ClosingCTA title="Hablemos" titleMuted="de tu casa" image={closingPhoto} origin="home-cierre" />
</BaseLayout>
