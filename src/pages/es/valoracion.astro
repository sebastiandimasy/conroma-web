---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ValuationWizard from '../../islands/ValuationWizard';
import { breadcrumbSchema, serviceSchema } from '../../lib/seo';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Valoración', path: '/es/valoracion/' },
];
---

<BaseLayout
  title="¿Cuánto vale mi piso? Valoración gratis"
  description="Dinos dónde está tu piso y en qué estado, y te decimos cuánto vale. Cuatro preguntas, gratis y sin compromiso."
  path="/es/valoracion/"
  schemas={[breadcrumbSchema(crumbs), serviceSchema('Valoración de inmuebles', 'Valoración gratis de tu piso en cuatro preguntas, sin compromiso.', '/es/valoracion/')]}
  bare
>
  <ValuationWizard client:load />
  <noscript>
    <div class="wrap wizard-fallback">
      <h2>¿Cuánto vale mi piso?</h2>
      <p>Para la valoración paso a paso hace falta JavaScript. Escríbenos por WhatsApp o llámanos y te lo decimos igual.</p>
    </div>
  </noscript>
</BaseLayout>
