---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroStory from '../../components/sections/HeroStory.astro';
import ProofBand from '../../components/sections/ProofBand.astro';
import StoryScroll from '../../components/sections/StoryScroll.astro';
import Compare from '../../components/sections/Compare.astro';
import ValuationBlock from '../../components/sections/ValuationBlock.astro';
import GuideTeaser from '../../components/sections/GuideTeaser.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import heroPhoto from '../../assets/equipo/conroma-74.jpg';
import closingPhoto from '../../assets/equipo/conroma-82.jpg';
import { venderAnswer, venderCompare, venderFaq, venderSteps } from '../../data/vender';
import { publishedSellerTowns } from '../../data/towns';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/seo';

/* Dueña de la búsqueda regional y de proceso («vender piso en el Maresme», «cómo vender mi
   piso»). «Vender piso en {pueblo}» es de cada hub: aquí solo se enlaza (spec §7.0). */
const path = '/es/vender/';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Vender', path },
];
const description = 'Vende tu piso o casa en el Maresme con Conroma: valoración gratis, fotos, visitas y acompañamiento hasta notaría.';
---

<BaseLayout
  title="Vender piso o casa en el Maresme"
  description={description}
  path={path}
  schemas={[breadcrumbSchema(crumbs), faqSchema(venderFaq), serviceSchema('Venta de viviendas', description, path)]}
>
  <HeroStory
    crumbs={crumbs}
    title="Vender tu piso en el Maresme"
    lead={venderAnswer}
    image={heroPhoto}
    alt="Una persona del equipo de Conroma explicando una operación en la pizarra"
    cta={{ label: '¿Cuánto vale mi piso?', href: '#valoracion' }}
  />

  <ProofBand kicker="En cifras" bridge="Esto es lo que hacemos con tu piso desde el primer día." />

  <StoryScroll
    kicker="El proceso"
    title="Cómo vendemos tu piso"
    steps={venderSteps}
    bridge="Si prefieres venderlo por tu cuenta, mira lo que cambia."
  />

  <Compare
    kicker="Comparativa"
    title="Con Conroma o por tu cuenta"
    columns={['Con Conroma', 'Por tu cuenta']}
    rows={venderCompare}
    bridge="Todo empieza por saber cuánto vale tu piso."
  />

  <ValuationBlock />

  <GuideTeaser kicker="Guías" title="Para leer antes de vender" category="Vender" />

  <FaqSection kicker="Preguntas frecuentes" title="Dudas al vender tu piso" items={venderFaq} />

  <ClosingCTA
    kicker="Contacto"
    title="¿Lo hablamos?"
    image={closingPhoto}
    text="Cuéntanos qué piso quieres vender y te decimos cómo lo haríamos."
    origin="vender-cierre"
    reason="valoracion"
  >
    <nav class="closing-cta__towns" aria-label="Vender en tu pueblo">
      <ul>
        {
          publishedSellerTowns.map((town) => (
            <li>
              <a href={`/es/inmobiliaria/${town.slug}/`}>Vender piso en {town.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </ClosingCTA>
</BaseLayout>
