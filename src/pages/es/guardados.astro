---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ContactSection from '../../components/sections/ContactSection.astro';
import SavedProperties from '../../islands/SavedProperties';
import { getListings } from '../../data/properties';
import { breadcrumbSchema } from '../../lib/seo';

const path = '/es/guardados/';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Guardados', path },
];
---

<BaseLayout
  title="Tus pisos guardados | Conroma"
  description="Los pisos que has guardado en Conroma Asesores, para compararlos con calma o enseñárselos a quien decida contigo."
  path={path}
  noindex
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Solo tú ves esto"
    title="Tus pisos "
    highlight="guardados"
    lead="Se guardan en este navegador, sin registrarte. Si cambias de móvil o de ordenador, no viajan contigo."
  />

  <section class="section">
    <div class="wrap">
      <SavedProperties client:load properties={getListings()} listingUrl="/es/venta/malgrat-de-mar/" />
    </div>
  </section>

  <ContactSection />
</BaseLayout>
