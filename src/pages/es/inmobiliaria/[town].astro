---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroStory from '../../../components/sections/HeroStory.astro';
import Statement from '../../../components/sections/Statement.astro';
import SplitFeature from '../../../components/sections/SplitFeature.astro';
import StoryScroll from '../../../components/sections/StoryScroll.astro';
import TownLinks from '../../../components/sections/TownLinks.astro';
import ValuationBlock from '../../../components/sections/ValuationBlock.astro';
import Testimonials from '../../../components/sections/Testimonials.astro';
import FaqSection from '../../../components/sections/FaqSection.astro';
import ClosingCTA from '../../../components/sections/ClosingCTA.astro';
import teamPhoto from '../../../assets/equipo/conroma-102.jpg';
import closingPhoto from '../../../assets/equipo/conroma-82.jpg';
import { townFaq } from '../../../data/faq';
import { venderSteps } from '../../../data/vender';
import { placePhotos } from '../../../data/creditos-fotos';
import { publishedCatalogTowns, publishedSellerTowns, type Town } from '../../../data/towns';
import { propertiesIn } from '../../../data/properties';
import { whatsappUrl } from '../../../lib/links';
import { breadcrumbSchema, faqSchema } from '../../../lib/seo';

export function getStaticPaths() {
  return publishedSellerTowns.map((town) => ({ params: { town: town.slug }, props: { town } }));
}

interface Props {
  town: Town;
}

const { town } = Astro.props;
const path = `/es/inmobiliaria/${town.slug}/`;
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Zonas', path: '/es/inmobiliaria/' },
  { name: `Inmobiliaria en ${town.name}`, path },
];

// Fotos del pueblo (src/assets/lugares/{town}/): la primera va al héroe con su crédito; la segunda, si hay, al bloque de compra.
const files = import.meta.glob<{ default: ImageMetadata }>('../../../assets/lugares/*/*.jpg', { eager: true });
const photoOf = (file: string) => files[`../../../${file}`]?.default;
const townPhotos = placePhotos.filter((photo) => photo.town === town.slug && photoOf(photo.file));
const hero = townPhotos[0];
const second = townPhotos[1];

// Si el pueblo tiene catálogo publicado, la FAQ y el bloque de compra lo dicen y enlazan.
const forSale = publishedCatalogTowns.some((t) => t.slug === town.slug) ? propertiesIn(town.slug, 'venta').length : 0;
const catalogPath = forSale ? `/es/venta/${town.slug}/` : null;
const answer =
  `En ${town.name}, Conroma Asesores te ayuda a vender, comprar y alquilar vivienda desde la oficina de Malgrat de Mar. ${town.sellerIntro} ` +
  'Valoramos tu piso gratis y sin compromiso, y una misma persona lleva la operación de principio a fin.';
const faq = town.buyerIntro
  ? [
      ...townFaq(town.name),
      {
        question: `¿Tenéis pisos en venta en ${town.name}?`,
        answer: forSale
          ? `Sí: ahora mismo ${forSale} ${forSale === 1 ? 'inmueble' : 'inmuebles'} en venta en ${town.name}, con fotos y precio, en nuestra página de pisos en venta en ${town.name}. Si buscas algo que no ves, dinos qué y te contamos también lo que aún no está anunciado.`
          : `Trabajamos en ${town.name}, pero todavía no publicamos ahí el catálogo en la web. Escríbenos diciendo qué buscas y te contamos qué hay, incluido lo que aún no está anunciado.`,
      },
      {
        question: `¿Me avisáis si entra algo en ${town.name}?`,
        answer: 'Sí. Dinos qué buscas y cuánto quieres gastarte y te escribimos cuando entre algo que encaje. Sin compromiso y sin registrarte en nada.',
      },
    ]
  : townFaq(town.name);
---

<BaseLayout
  title={`Inmobiliaria en ${town.name}: comprar y vender | Conroma`}
  description={`¿Compras o vendes en ${town.name}? Te decimos qué hay a la venta, también lo que no está anunciado, y valoramos tu piso gratis y sin compromiso.`}
  path={path}
  schemas={[breadcrumbSchema(crumbs), faqSchema(faq)]}
>
  {
    hero ? (
      <HeroStory
        crumbs={crumbs}
        title={`Inmobiliaria en ${town.name}`}
        lead={town.intro || town.sellerIntro}
        image={photoOf(hero.file)!}
        alt={hero.alt}
        cta={{ label: 'Saber cuánto vale mi piso', href: '/es/valoracion/' }}
        credit={hero.attributionRequired ? { text: `Foto: ${hero.author} · ${hero.license}`, href: hero.url } : undefined}
      />
    ) : (
      <HeroStory
        crumbs={crumbs}
        title={`Inmobiliaria en ${town.name}`}
        lead={town.intro || town.sellerIntro}
        image={teamPhoto}
        alt="El equipo de Conroma Asesores en la oficina de Malgrat de Mar"
        cta={{ label: 'Saber cuánto vale mi piso', href: '/es/valoracion/' }}
      />
    )
  }

  <Statement text={answer} />

  {
    town.buyerIntro ? (
      <SplitFeature
        id="comprar"
        tone="canvas"
        title={`Comprar en ${town.name}`}
        text={`${town.buyerIntro} Te decimos qué hay ahora, incluido lo que aún no está anunciado, y te avisamos cuando entra algo que encaje.`}
        image={second ? photoOf(second.file)! : teamPhoto}
        alt={second ? second.alt : 'El equipo de Conroma revisando pisos en la oficina'}
        link={
          catalogPath
            ? { label: `Ver pisos en venta en ${town.name}`, href: catalogPath }
            : {
                label: `Decidnos qué buscáis en ${town.name}`,
                href: whatsappUrl({ reason: 'general' }),
                contact: 'whatsapp',
                origin: `pueblo-${town.slug}-comprar`,
              }
        }
      />
    ) : (
      <SplitFeature
        tone="canvas"
        title={`Vender tu piso en ${town.name}`}
        text={`${town.sellerIntro} Pasamos a verlo, te damos un precio realista y nos encargamos de fotos, visitas, negociación y papeles.`}
        image={second ? photoOf(second.file)! : teamPhoto}
        alt={second ? second.alt : 'El equipo de Conroma revisando pisos en la oficina'}
        link={{ label: 'Saber cuánto vale mi piso', href: '/es/valoracion/' }}
      />
    )
  }

  <StoryScroll title={`Vender en ${town.name}, paso a paso`} steps={venderSteps} />

  <TownLinks current={town.slug} tone="canvas" />

  <ValuationBlock title={`¿Cuánto vale tu piso en ${town.name}?`} lead="Pon la dirección y te lo decimos. Gratis y sin compromiso." />

  <Testimonials tone="canvas" lead="Hacemos cada proyecto con pasión y profesionalidad, y así lo reflejan nuestros clientes." />

  <FaqSection title={`${town.name}: lo que nos preguntan`} items={faq} origin={`pueblo-${town.slug}-faq`} />

  <ClosingCTA title="Hablemos" titleMuted={`de tu piso en ${town.name}`} image={closingPhoto} origin={`pueblo-${town.slug}-cierre`} />
</BaseLayout>
