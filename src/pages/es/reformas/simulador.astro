---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/sections/PageHero.astro';
import ContactSection from '../../../components/sections/ContactSection.astro';
import ReformSimulator from '../../../islands/ReformSimulator';
import { breadcrumbSchema } from '../../../lib/seo';

const path = '/es/reformas/simulador/';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Reformas', path: '/es/reformas/' },
  { name: 'Simulador de reformas', path },
];
---

<BaseLayout
  title="Simulador de reformas: cuánto cuesta reformar un piso"
  description="Calcula cuánto puede costar la reforma integral de tu piso según los metros y la calidad de los acabados. Orientativo y sin dejar tus datos."
  path={path}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Conroma en Obras"
    title="¿Cuánto cuesta "
    highlight="reformar mi piso?"
    lead="Pon los metros y la calidad que buscas, y te sale una idea de por dónde van los tiros."
  >
    <a class="button button--ghost button--large" href="/es/reformas/">Cómo hacemos las reformas</a>
  </PageHero>

  <section class="section simulator-section">
    <div class="wrap">
      <div class="simulator-card glass" data-reveal>
        <ReformSimulator client:load />
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
