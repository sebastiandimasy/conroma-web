---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import ClosingCTA from '../../../components/sections/ClosingCTA.astro';
import InstagramReel from '../../../components/sections/InstagramReel.astro';
import closingPhoto from '../../../assets/equipo/conroma-82.jpg';
import { posts, type BlogPost } from '../../../data/blog';
import { site } from '../../../data/site';
import { articleSchema, breadcrumbSchema, videoSchema } from '../../../lib/seo';
import type { ImageMetadata } from 'astro';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const path = `/es/blog/${post.slug}/`;
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Blog', path: '/es/blog/' },
  { name: post.title, path },
];
const formatDate = (date: string) =>
  new Date(date).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const dateLabel = formatDate(post.date);
const others = posts.filter((item) => item.slug !== post.slug).slice(0, 2);
// Portada del reel (src/assets/blog/reels/{id}.jpg): fondo mientras carga el iframe y miniatura del VideoObject.
const reelPosters = import.meta.glob<{ default: ImageMetadata }>('../../../assets/blog/reels/*.jpg', { eager: true });
const poster = post.video ? reelPosters[`../../../assets/blog/reels/${post.video.instagram}.jpg`]?.default : undefined;
const schemas: object[] = [breadcrumbSchema(crumbs), articleSchema(post)];
if (post.video && poster) schemas.push(videoSchema(post, post.video, poster.src));
---

<BaseLayout
  title={post.title}
  description={post.description}
  path={path}
  schemas={schemas}
  noindex={post.draft}
>
  <article class="article">
    <header class="page-head page-head--editorial">
      <div class="wrap article__wrap">
        <Breadcrumbs crumbs={crumbs} />
        <h1 class="page-head__title">{post.title}</h1>
        <p class="page-head__lead">{post.intro}</p>
        <p class="article__byline">
          {post.category} · Por <a href={post.author.href}>{post.author.name}</a>, {post.author.role} · <time datetime={post.date}>{dateLabel}</time>
          {post.updated && post.updated !== post.date && (
            <>
              {' '}· Actualizado el <time datetime={post.updated}>{formatDate(post.updated)}</time>
            </>
          )}
        </p>
        {post.draft && <p class="article__draft">Borrador pendiente de revisión por Conroma.</p>}
      </div>
    </header>
    <div class="wrap article__wrap article__body">
      {post.video && <InstagramReel id={post.video.instagram} title={post.video.title} poster={poster} />}
      {
        post.sections.map((section) => (
          <section class="article__section">
            <h2 class="article__heading">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.list && <ul class="article__list">{section.list.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))
      }
      <p class="article__cta">
        <a class="button button--primary button--large" href={post.cta.href}>{post.cta.label}</a>
      </p>
      <aside class="article__author">
        <p>
          <strong>{post.author.name}</strong>, {post.author.role}. Conroma es una inmobiliaria familiar de {site.address.locality}.{' '}
          <a href="/es/empresa/">Conoce la empresa</a> o <a href="/es/contacto/">escríbenos</a> si tienes dudas sobre tu caso.
        </p>
      </aside>
    </div>
  </article>
  {
    others.length > 0 && (
      <section class="section guide-teaser guide-teaser--surface">
        <div class="wrap">
          <h2 class="section__title" data-reveal>Más guías</h2>
          <ul class="guide-teaser__list">
            {others.map((item) => (
              <li data-reveal>
                <a class="guide-teaser__card" href={`/es/blog/${item.slug}/`}>
                  <p class="guide-teaser__date">{item.category}</p>
                  <h3 class="guide-teaser__title">{item.title}</h3>
                  <p class="guide-teaser__text">{item.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
  <ClosingCTA title="Hablemos" titleMuted="de tu caso" image={closingPhoto} origin="blog-articulo-cierre" />
</BaseLayout>
