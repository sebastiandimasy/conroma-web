---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import PropertyGallery from '../../../islands/PropertyGallery';
import FavoriteToggle from '../../../islands/FavoriteToggle';
import ContactOptions from '../../../islands/ContactOptions';
import PropertyGrid from '../../../islands/PropertyGrid';
import ApproxLocationMap from '../../../islands/ApproxLocationMap';
import { cardFacts, getListings, hasPublicPrice, isHome, propertySlug, propertyTitle, type Property } from '../../../data/properties';
import { findTown, publishedCatalogTowns } from '../../../data/towns';
import { site } from '../../../data/site';
import { formatFloor, formatPrice } from '../../../lib/format';
import { breadcrumbSchema, listingSchema } from '../../../lib/seo';

export function getStaticPaths() {
  return getListings().map((property) => ({ params: { slug: propertySlug(property) }, props: { property } }));
}

interface Props {
  property: Property;
}

const { property } = Astro.props;
const town = findTown(property.town);
const townName = town?.name ?? property.town;
// Coords reales del piso (feed) si las hay; si no, el centro del pueblo.
const mapGeo = property.geo ?? town?.geo ?? null;
const title = propertyTitle(property);
const titleWithPrice = (item: Property) => (hasPublicPrice(item) ? `${propertyTitle(item)} — ${formatPrice(item.price)}` : propertyTitle(item));
// Fichas gemelas (mismo tipo, zona y precio) compartían <title>: la referencia las distingue.
const hasTwin = getListings().some((item) => item.ref !== property.ref && titleWithPrice(item) === titleWithPrice(property));
const docTitle = hasTwin ? `${titleWithPrice(property)} · Ref. ${property.ref}` : titleWithPrice(property);
// Terrenos, locales y parkings no tienen habitaciones: fuera el «0 habitaciones, 0 baños».
const summary = isHome(property)
  ? `${property.rooms} ${property.rooms === 1 ? 'habitación' : 'habitaciones'}, ${property.baths} ${property.baths === 1 ? 'baño' : 'baños'}, ${property.area} m²`
  : `${property.area} m²`;
const path = `/es/inmueble/${propertySlug(property)}/`;
// Si el pueblo no tiene página de catálogo (pueblo fino, fuera del índice), enlaza al listado general.
const listingPath = publishedCatalogTowns.some((t) => t.slug === property.town)
  ? `/es/venta/${property.town}/`
  : '/es/venta/';
const drop = property.previousPrice ? property.previousPrice - property.price : 0;
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: `Inmuebles en venta en ${townName}`, path: listingPath },
  { name: `${property.type} en ${property.zone}`, path },
];
const similar = getListings({ town: property.town, operation: property.operation })
  .filter((item) => item.ref !== property.ref)
  .sort((a, b) => Math.abs(a.price - property.price) - Math.abs(b.price - property.price))
  .slice(0, 3);
// Una ficha sin fotos no merece estar en Google: se queda fuera aunque la cartera
// ya sea indexable (hoy son 8 de 126).
const hasPhotos = Boolean(property.images && property.images.length > 0);
const indexable = site.catalogIndexable && hasPhotos;
// «Zona, pueblo» sin repetir cuando la zona es el propio pueblo (Malgrat de Mar, Malgrat de Mar).
const place = property.zone && property.zone !== townName ? `${property.zone}, ${townName}` : townName;
const home = isHome(property);
// La planta y el ascensor solo dicen algo en pisos; en una casa, «planta baja» confunde.
const flat = /piso|ático|dúplex|estudio|apartamento|bungalow|loft/i.test(property.type);
// Datos de cabecera sin ceros (terrenos, locales y parkings no tienen habitaciones ni planta).
const facts = flat ? [...cardFacts(property), formatFloor(property.floor)] : cardFacts(property);
const features = [
  { label: 'Tipo', value: property.type },
  { label: 'Estado', value: property.state },
  ...(flat
    ? [
        { label: 'Planta', value: formatFloor(property.floor) },
        { label: 'Ascensor', value: property.elevator ? 'Sí' : 'Consultar' },
      ]
    : []),
  ...(home
    ? [
        { label: 'Parking', value: property.parking ? 'Sí' : 'Consultar' },
        { label: 'Terraza o balcón', value: property.terrace ? 'Sí' : 'Consultar' },
      ]
    : []),
  // Obligatorio en la publicidad (RD 390/2021): sale en cuanto el feed de Habitatsoft lo traiga.
  ...(property.energyRating
    ? [{ label: 'Certificado energético', value: `Letra ${property.energyRating}` }]
    : property.energyExempt
      ? [{ label: 'Certificado energético', value: 'Exento' }]
      : []),
  { label: 'Referencia', value: property.ref },
];
---

<BaseLayout
  title={docTitle}
  description={`${title}${hasPublicPrice(property) ? ` por ${formatPrice(property.price)}` : ''}: ${summary}. Ref. ${property.ref}. ${property.description}`.trim()}
  path={path}
  schemas={[breadcrumbSchema(crumbs), listingSchema(property)]}
  contact={{ propertyRef: property.ref, propertyTitle: title }}
  primaryAction={{ label: 'Pedir visita', href: '#contacto' }}
  noindex={!indexable}
>
  <article class="property">
    <div class="wrap property__top">
      <Breadcrumbs crumbs={crumbs} />
    </div>

    <div class="wrap property__layout">
      <div class="property__main">
        <header class="property__summary">
          <h1 class="property__title">{title}</h1>
          <p class="property__place">{place} · Ref. {property.ref}</p>
          <div class="property__price-row">
            <p class="property__price">
              {
                hasPublicPrice(property) ? (
                  <data value={property.price}>{formatPrice(property.price)}</data>
                ) : (
                  <span class="property-card__price--ask">Precio a consultar</span>
                )
              }
            </p>
            <div class="property__save">
              <FavoriteToggle client:load propertyRef={property.ref} label />
            </div>
          </div>
          {
            drop > 0 && property.previousPrice && (
              <p class="property__drop">
                Antes {formatPrice(property.previousPrice)} · ha bajado {formatPrice(drop)}
              </p>
            )
          }
        </header>

        <div class="property__gallery">
          <PropertyGallery client:load propertyRef={property.ref} title={title} photos={property.photos} tone={property.tone} images={property.images} />
        </div>

        <div class="property__overview">
          {facts.length > 0 && (
            <ul class="property__facts">
              {facts.map((fact) => <li>{fact}</li>)}
            </ul>
          )}
          {
            hasPublicPrice(property) && (
              <a class="link-cta property__mortgage" href={`/es/comprar/puedo-comprar/?precio=${property.price}`}>
                ¿Me lo puedo permitir? Calcúlalo
              </a>
            )
          }
        </div>

        {
          (property.description || property.likes || property.watchOut) && (
            <section class="property__block" id="resumen">
              <h2 class="property__heading">Te lo contamos fácil</h2>
              {property.description && <p class="property__description">{property.description}</p>}
              {
                (property.likes || property.watchOut) && (
              <div class="honesty">
                {property.likes && (
                  <div class="honesty__item">
                    <h3 class="honesty__title">Lo que más nos gusta</h3>
                    <p>{property.likes}</p>
                  </div>
                )}
                {property.watchOut && (
                  <div class="honesty__item">
                    <h3 class="honesty__title">A tener en cuenta</h3>
                    <p>{property.watchOut}</p>
                  </div>
                )}
              </div>
            )
          }
            </section>
          )
        }

        <section class="property__block" id="caracteristicas">
          <h2 class="property__heading">Características</h2>
          <dl class="spec-list">
            {
              features.map((feature) => (
                <div class="spec-list__row">
                  <dt>{feature.label}</dt>
                  <dd>{feature.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="property__block" id="zona">
          <h2 class="property__heading">La zona</h2>
          <p class="property__description">
            {place}. En el mapa te situamos la zona aproximada; la dirección exacta te la contamos cuando hablemos.
          </p>
          {
            mapGeo && (
              <div class="property__map">
                <ApproxLocationMap
                  client:visible
                  latitude={mapGeo.latitude}
                  longitude={mapGeo.longitude}
                  label={`${property.zone}, ${townName}`}
                />
              </div>
            )
          }
          <nav class="link-list" aria-label="Zona">
            <a class="link-list__link" href={listingPath}>
              Más pisos en venta en {townName}
              <Icon name="arrow" class="link-list__arrow" />
            </a>
          </nav>
        </section>
      </div>

      <aside class="property__aside" id="contacto">
        <div class="contact-card">
          <h2 class="property__heading">¿Qué necesitas?</h2>
          {
            site.agent && (
              <div class="agent">
                <img class="agent__photo" src={site.agent.photo} alt={site.agent.name} width="64" height="64" loading="lazy" />
                <p>
                  <strong>{site.agent.name}</strong>
                  <br />
                  Conoce este piso por dentro
                </p>
              </div>
            )
          }
          <ContactOptions client:visible propertyRef={property.ref} propertyTitle={title} />
        </div>
      </aside>
    </div>

    {
      similar.length > 0 && (
        <section class="section similar">
          <div class="wrap">
            <div class="section__head">
              <h2 class="section__title">Viviendas parecidas</h2>
            </div>
            <PropertyGrid client:visible properties={similar} townName={townName} origin="ficha-parecidas" />
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
