---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroStory from '../../components/sections/HeroStory.astro';
import Statement from '../../components/sections/Statement.astro';
import SplitFeature from '../../components/sections/SplitFeature.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import heroPhoto from '../../assets/lugares/malgrat-de-mar/parc-del-castell.jpg';
import searchPhoto from '../../assets/servicios/alquiler.jpg';
import ownerPhoto from '../../assets/equipo/conroma-102.jpg';
import closingPhoto from '../../assets/equipo/conroma-91.jpg';
import { placePhotos } from '../../data/creditos-fotos';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/seo';
import { whatsappUrl } from '../../lib/links';

/* Dos caminos en una página: quien busca piso de alquiler y quien tiene uno para alquilar.
   Cada uno con su bloque y su WhatsApp medido por Click URL (data-origin propio). */
const path = '/es/alquilar/';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Alquilar', path },
];
// Foto CC BY-SA: el crédito va visible en el propio hero.
const heroCredit = placePhotos.find((photo) => photo.town === 'malgrat-de-mar' && photo.name === 'parc-del-castell')!;
const description =
  'Alquiler en Malgrat de Mar con Conroma: te ayudamos a encontrar piso de alquiler o a encontrar inquilino para el tuyo.';
const answer =
  'Conroma te ayuda con el alquiler en Malgrat de Mar y el Alt Maresme, tanto si buscas piso como si tienes uno y quieres alquilarlo con seguridad. ' +
  'A quien busca, le decimos qué hay hoy y le avisamos cuando entra algo. Al propietario, le buscamos inquilino, enseñamos el piso y preparamos el contrato, con todo explicado antes de firmar.';
const faq = [
  {
    question: '¿Tenéis pisos de alquiler ahora mismo?',
    answer: 'Cambia cada semana y todavía no los publicamos en la web. Escríbenos y te decimos qué hay hoy.',
  },
  {
    question: 'Tengo un piso vacío, ¿me buscáis inquilino?',
    answer: 'Sí. Buscamos el inquilino, enseñamos el piso y preparamos el contrato. Tú decides a quién se lo alquilas.',
  },
  {
    question: 'Y después de firmar, ¿os podéis encargar del piso?',
    answer:
      'Sí, con la gestión de patrimonio: nos encargamos de la gestión y la administración del inmueble para que tú ganes libertad y tranquilidad.',
  },
];
---

<BaseLayout
  title="Alquilar piso en Malgrat de Mar"
  description={description}
  path={path}
  schemas={[breadcrumbSchema(crumbs), faqSchema(faq), serviceSchema('Alquiler de viviendas', description, path)]}
>
  <HeroStory
    crumbs={crumbs}
    title="Alquilar piso en Malgrat de Mar"
    lead="Tanto si buscas piso como si tienes uno y quieres alquilarlo con seguridad."
    image={heroPhoto}
    alt={heroCredit.alt}
    cta={{ label: 'Busco piso de alquiler', href: '#busco' }}
    credit={{ text: `Foto: ${heroCredit.author} · ${heroCredit.license}`, href: heroCredit.url }}
  />

  <Statement text={answer} />

  <SplitFeature
    id="busco"
    tone="canvas"
    title="Busco piso de alquiler"
    text="Dinos zona, presupuesto y para cuándo. Te decimos qué tenemos hoy y te avisamos cuando entre algo que te cuadre."
    image={searchPhoto}
    alt="Carpeta de Conroma sobre el plano de un piso"
    link={{ label: 'Preguntar qué hay ahora', href: whatsappUrl({ reason: 'general' }), contact: 'whatsapp', origin: 'alquilar-busco' }}
  />

  <SplitFeature
    id="tengo-piso"
    tone="surface"
    reverse
    title="Tengo un piso para alquilar"
    text="Buscamos inquilino, enseñamos el piso y preparamos el contrato, con todo explicado antes de firmar. Tú decides a quién se lo alquilas."
    image={ownerPhoto}
    alt="El equipo de Conroma revisando un contrato en la oficina"
    link={{ label: 'Quiero alquilar mi piso', href: whatsappUrl({ reason: 'alquiler' }), contact: 'whatsapp', origin: 'alquilar-propietario' }}
  />

  <Testimonials tone="canvas" lead="Hacemos cada proyecto con pasión y profesionalidad, y así lo reflejan nuestros clientes." />

  <FaqSection title="Lo que más preguntan del alquiler" items={faq} origin="alquilar-faq" reason="alquiler" />

  <ClosingCTA title="Hablemos" titleMuted="de tu alquiler" image={closingPhoto} origin="alquilar-cierre" reason="alquiler" />
</BaseLayout>
