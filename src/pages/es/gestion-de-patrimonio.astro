---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroStory from '../../components/sections/HeroStory.astro';
import Statement from '../../components/sections/Statement.astro';
import ProofBand from '../../components/sections/ProofBand.astro';
import StoryScroll from '../../components/sections/StoryScroll.astro';
import ServiceIndex from '../../components/sections/ServiceIndex.astro';
import ContentGuide from '../../components/sections/ContentGuide.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import ClosingCTA from '../../components/sections/ClosingCTA.astro';
import heroPhoto from '../../assets/servicios/gestion-patrimonio.jpg';
import tenantPhoto from '../../assets/servicios/alquiler.jpg';
import deskPhoto from '../../assets/equipo/conroma-91.jpg';
import reviewPhoto from '../../assets/equipo/conroma-102.jpg';
import closingPhoto from '../../assets/equipo/conroma-74.jpg';
import type { StoryStep } from '../../data/vender';
import { publishedSellerTowns } from '../../data/towns';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/seo';

/* Keyword (docs/KEYWORDS.md): «gestión de patrimonio inmobiliario»; secundarias: administración
   de inmuebles, gestión de alquileres Maresme. Enlaza a Alquilar sin duplicarla (spec §9). */
const path = '/es/gestion-de-patrimonio/';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Gestión de patrimonio', path },
];
const description =
  'Gestión de patrimonio inmobiliario en Malgrat de Mar: si tienes uno o varios inmuebles, nos encargamos de su gestión y administración.';
const answer =
  'La gestión de patrimonio de Conroma es para propietarios con uno o varios inmuebles en Malgrat de Mar y el Alt Maresme. ' +
  'Buscamos inquilino, somos su contacto en el día a día y miramos contigo el conjunto: qué conviene alquilar, vender o reformar. Tú ganas libertad y tranquilidad, y estás al tanto de todo.';
const trackRecord = [
  { value: '+300', label: 'inmuebles gestionados' },
  { value: '+100', label: 'clientes satisfechos' },
  { value: '+200', label: 'pisos vendidos' },
];
const steps: StoryStep[] = [
  {
    title: 'Buscamos inquilino',
    text: 'Anunciamos el piso, lo enseñamos y te presentamos a quien encaja. Tú decides a quién se lo alquilas.',
    image: tenantPhoto,
    alt: 'Carpeta de Conroma sobre el plano de un piso',
  },
  {
    title: 'Lo llevamos por ti',
    text: 'Somos el contacto del inquilino para el día a día, y tú estás al tanto de todo.',
    image: deskPhoto,
    alt: 'Una asesora de Conroma atendiendo desde la oficina',
  },
  {
    title: 'Miramos el conjunto',
    text: 'Si tienes más de un inmueble, vemos contigo qué conviene alquilar, vender o reformar.',
    image: reviewPhoto,
    alt: 'El equipo de Conroma revisando documentación en la oficina',
  },
];
const townNames = new Intl.ListFormat('es', { type: 'conjunction' }).format(
  publishedSellerTowns.filter((town) => town.slug !== 'malgrat-de-mar').map((town) => town.name),
);
// Qué supone administrar un piso alquilado (normativa general: LAU, INCASÒL, IRPF).
const guide = [
  {
    title: 'El inquilino',
    text: 'Atender sus avisos y dudas del día a día y ser su interlocutor durante todo el contrato.',
  },
  {
    title: 'Averías y reparaciones',
    text: 'Por ley, el propietario paga las reparaciones necesarias para que la vivienda siga siendo habitable; las pequeñas, por el desgaste del uso diario, son del inquilino.',
  },
  {
    title: 'Contrato y prórrogas',
    text: 'Fechas de prórroga, actualización de la renta según lo pactado y fin del contrato, avisando con la antelación que marca la ley.',
  },
  {
    title: 'Fianza y suministros',
    text: 'Depositar la fianza en el INCASÒL al firmar y ocuparse de los suministros cuando entra o sale un inquilino.',
  },
  {
    title: 'Impuestos',
    text: 'Las rentas del alquiler se declaran en el IRPF y el IBI llega cada año. Tenerlo ordenado ahorra sustos en la declaración.',
  },
  {
    title: 'Varios inmuebles',
    text: 'Con más de uno, conviene mirar el conjunto: qué conviene alquilar, vender o reformar en cada caso.',
  },
];
const faq = [
  {
    question: '¿Qué incluye la gestión de patrimonio?',
    answer:
      'Buscamos inquilino, enseñamos el piso y preparamos el contrato. Después somos el contacto del inquilino para el día a día y tú estás al tanto de todo.',
  },
  {
    question: '¿Sirve si solo tengo un piso?',
    answer: 'Sí. Es para quien tiene uno o varios inmuebles y prefiere que nos encarguemos de su gestión y administración.',
  },
  {
    question: 'Tengo varios inmuebles, ¿me ayudáis a decidir qué hacer con cada uno?',
    answer: 'Sí. Vemos contigo el conjunto y qué conviene alquilar, vender o reformar en cada caso.',
  },
  {
    question: '¿En qué zonas gestionáis inmuebles?',
    answer: `En Malgrat de Mar y en los pueblos de alrededor: ${townNames}.`,
  },
];
---

<BaseLayout
  title="Gestión de patrimonio inmobiliario en Malgrat de Mar"
  description={description}
  path={path}
  schemas={[breadcrumbSchema(crumbs), faqSchema(faq), serviceSchema('Gestión de patrimonio inmobiliario', description, path)]}
>
  <HeroStory
    crumbs={crumbs}
    title="Gestión de patrimonio en Malgrat de Mar"
    lead="Si tienes uno o varios inmuebles, nos encargamos de su gestión y administración para que tú ganes libertad y tranquilidad."
    image={heroPhoto}
    alt="Gestión de inmuebles de Conroma desde el ordenador"
    cta={{ label: 'Lo que llevamos nosotros', href: '#que-llevamos' }}
  />

  <Statement text={answer} />

  <ProofBand figures={trackRecord} count />

  <StoryScroll id="que-llevamos" title="Lo que llevamos nosotros" steps={steps} />

  <ContentGuide
    title="Qué supone administrar un piso alquilado"
    lead="Esto es lo que lleva un piso alquilado. Cuéntanos tu caso y vemos qué parte llevamos nosotros."
    items={guide}
  />

  <FaqSection title="Gestión de patrimonio: lo que nos preguntan" items={faq} origin="patrimonio-faq" />

  <ServiceIndex title="Lo que podemos hacer con tus inmuebles" exclude="gestion-de-patrimonio" />

  <Testimonials lead="Hacemos cada proyecto con pasión y profesionalidad, y así lo reflejan nuestros clientes." />

  <ClosingCTA title="Hablemos" titleMuted="de tus inmuebles" image={closingPhoto} origin="patrimonio-cierre" />
</BaseLayout>
