---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ContactSection from '../../components/sections/ContactSection.astro';
import OfficeMap from '../../components/sections/OfficeMap.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import TownLinks from '../../components/sections/TownLinks.astro';
import { homeFaq } from '../../data/faq';
import { agentSchema, breadcrumbSchema } from '../../lib/seo';

const path = '/es/contacto/';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Contacto', path },
];
---

<BaseLayout
  title="Contacto: habla con Conroma en Malgrat de Mar"
  description="Escríbenos por WhatsApp, llámanos o pásate por la oficina de la Av. Mediterránea 16, en Malgrat de Mar."
  path={path}
  schemas={[agentSchema(), breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Estamos a un mensaje"
    title="Resolvemos tus dudas "
    highlight="en un segundo."
    lead="Escríbenos por WhatsApp, llámanos o pásate por la oficina. Si tienes cualquier duda adicional, aquí estamos."
  />
  <ContactSection />
  <OfficeMap />
  <TownLinks />
  <FaqSection items={homeFaq} />
</BaseLayout>
