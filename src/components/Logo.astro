---
import { LOGO_PATHS, LOGO_VIEWBOX } from '../lib/logo';

interface Props {
  class?: string;
  size?: number;
  fixed?: boolean;
}

const { class: className, size = 32, fixed = false } = Astro.props;
---

<svg class:list={[className, { 'logo--fixed': fixed }]} viewBox={LOGO_VIEWBOX} width={size} height={size} fill="currentColor" aria-hidden="true">
  {LOGO_PATHS.map((d) => <path d={d} />)}
</svg>

<style>
  .logo--fixed {
    color: #161615;
  }
</style>
