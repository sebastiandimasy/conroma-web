---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import Icon from '../Icon.astro';
import type { Crumb } from '../../lib/seo';

interface Props {
  crumbs: Crumb[];
  title: string;
  lead: string;
  image: ImageMetadata;
  alt: string;
  cta: { label: string; href: string };
}

const { crumbs, title, lead, image, alt, cta } = Astro.props;
---

<section class="hero-story">
  {/* Imagen LCP: nunca lazy. El hero llega quieto: sin reveal ni parallax. */}
  <Image
    class="hero-story__photo"
    src={image}
    alt={alt}
    widths={[390, 780, 1200, 1800]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  {/* Composición editorial: titular arriba, migas + respuesta + acción abajo, con su velo. */}
  <div class="wrap hero-story__content">
    <h1 class="hero-story__title">{title}</h1>
    <div class="hero-story__foot">
      <Breadcrumbs crumbs={crumbs} />
      <p class="hero-story__lead">{lead}</p>
      <a class="arrow-link" href={cta.href}>
        <span class="arrow-link__icon"><Icon name="arrow" /></span>
        <span class="arrow-link__label">{cta.label}</span>
      </a>
    </div>
  </div>
</section>
