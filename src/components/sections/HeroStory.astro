---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import Icon from '../Icon.astro';
import type { Crumb } from '../../lib/seo';

interface Props {
  /** Sin migas en Inicio. */
  crumbs?: Crumb[];
  title: string;
  lead: string;
  image: ImageMetadata;
  alt: string;
  cta: { label: string; href: string };
  /** Crédito visible de la foto (obligatorio en fotos CC BY-SA). */
  credit?: { text: string; href: string };
  /** Encuadre de la foto (object-position). Por defecto, el del CSS (center 25%). */
  position?: string;
}

const { crumbs, title, lead, image, alt, cta, credit, position } = Astro.props;
---

<section class="hero-story">
  {/* Imagen LCP: nunca lazy. El hero llega quieto: sin reveal ni parallax. */}
  <Image
    class="hero-story__photo"
    src={image}
    alt={alt}
    widths={[390, 780, 1200, 1800]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    style={position && `object-position: ${position}`}
  />
  {/* Un solo bloque anclado abajo: migas → titular → apoyo → acción. La foto respira arriba. */}
  <div class="wrap hero-story__content">
    <div class="hero-story__copy">
      {crumbs && <Breadcrumbs crumbs={crumbs} />}
      <h1 class="hero-story__title">{title}</h1>
      <p class="hero-story__lead">{lead}</p>
      <a class="arrow-link hero-story__cta" href={cta.href}>
        <span class="arrow-link__icon"><Icon name="arrow" /></span>
        <span class="arrow-link__label">{cta.label}</span>
      </a>
    </div>
  </div>
  {
    credit && (
      <a class="hero-story__credit" href={credit.href} rel="noopener" target="_blank">
        {credit.text}
      </a>
    )
  }
</section>
