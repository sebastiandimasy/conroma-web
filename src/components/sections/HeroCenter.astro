---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  lead: string;
  image: ImageMetadata;
  alt: string;
  primary: { label: string; href: string };
  /** Acción secundaria: texto clicable, sin borde. Si es wa.me / tel:, lleva data-contact para medir por Click URL. */
  secondary: { label: string; href: string; contact?: 'whatsapp' | 'llamada'; origin?: string };
  /** Encuadre de la foto (object-position). */
  position?: string;
}

const { title, lead, image, alt, primary, secondary, position } = Astro.props;
---

{/* Héroe de Inicio: foto del equipo a sangre, velo y todo centrado (titular → apoyo → dos acciones).
    Entrada escalonada solo con CSS; con reduced-motion llega quieto. */}
<section class="hero-center">
  <Image
    class="hero-center__photo"
    src={image}
    alt={alt}
    widths={[390, 780, 1200, 1800]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    style={position && `object-position: ${position}`}
  />
  <div class="wrap hero-center__content">
    <h1 class="hero-center__title">{title}</h1>
    <p class="hero-center__lead">{lead}</p>
    <div class="hero-center__actions">
      <a class="button button--primary button--large" href={primary.href}>{primary.label}</a>
      <a
        class="hero-center__link"
        href={secondary.href}
        data-contact={secondary.contact}
        data-origin={secondary.origin}
      >
        {secondary.label}
      </a>
    </div>
  </div>
</section>
