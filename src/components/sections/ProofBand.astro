---
import { site } from '../../data/site';
import { getListings } from '../../data/properties';
import { proofFigures, type ProofFigure } from '../../lib/proof';
import { getLang, strings } from '../../i18n';

interface Props {
  figures?: ProofFigure[];
  /** Frase que anuncia la sección siguiente. */
  bridge?: string;
}

const lang = getLang(Astro.url);
const t = strings({
  es: { label: 'Datos de Conroma' },
  en: { label: 'Conroma in figures' },
  ca: { label: 'Dades de Conroma' },
})[lang];

// Cifras escritas en el HTML (Google y las IA las leen tal cual).
const {
  figures = proofFigures({
    rating: site.googleRating,
    yearsActive: site.yearsActive,
    listings: getListings().length,
    builtOn: new Date(),
    lang,
  }),
  bridge,
} = Astro.props;
---

{
  figures.length > 0 && (
    <section class="proof-band" aria-label={t.label}>
      <div class="wrap">
        <dl class="proof-band__list">
          {figures.map((figure, index) => (
            <div class="proof-band__item">
              <dt class="proof-band__label">{figure.label}</dt>
              <dd class="proof-band__value" data-reveal="cifra">{figure.value}</dd>
              {/* Nota y reseñas comparten fuente: se cita una vez. */}
              {figure.source && figure.source !== figures[index - 1]?.source && (
                <dd class="proof-band__source">
                  {figure.href ? (
                    <a href={figure.href} rel="noopener" target="_blank">
                      {figure.source}
                    </a>
                  ) : (
                    figure.source
                  )}
                </dd>
              )}
            </div>
          ))}
        </dl>
        {bridge && <p class="section__bridge">{bridge}</p>}
      </div>
    </section>
  )
}

