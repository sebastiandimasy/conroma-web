---
import Icon from '../Icon.astro';
import { services } from '../../data/services';
import { getLang, localizePath, strings } from '../../i18n';

interface Props {
  title: string;
  exclude?: string;
  /** Inicio: acordeón con la foto del servicio abierto (al lado en escritorio, dentro en móvil). */
  photos?: boolean;
  /** Ancla (p. ej. la flecha del héroe de Servicios). */
  id?: string;
}

const { title, exclude, photos = false, id } = Astro.props;
const lang = getLang(Astro.url);
const list = services[lang].filter((service) => service.slug !== exclude);
const t = strings({
  es: {
    more: (name: string) => `Más sobre ${name.toLowerCase()}`,
    alts: {
      comprar: 'Entrega de llaves de una vivienda comprada con Conroma',
      vender: 'Herman, de Conroma, preparando la tasación de un piso',
      alquilar: 'Piso en alquiler gestionado por Conroma',
      'gestion-de-patrimonio': 'Gestión de patrimonio inmobiliario con Conroma',
      reformas: 'Reforma e interiorismo de Conroma en Obras',
    },
  },
  en: {
    more: (name: string) => `More about ${name.toLowerCase()}`,
    alts: {
      comprar: 'Handing over the keys to a home bought with Conroma',
      vender: 'Herman, from Conroma, preparing a property valuation',
      alquilar: 'Rental apartment managed by Conroma',
      'gestion-de-patrimonio': 'Property portfolio management with Conroma',
      reformas: 'Renovation and interior design by Conroma en Obras',
    },
  },
  ca: {
    more: (name: string) => `Més sobre ${name.toLowerCase()}`,
    alts: {
      comprar: "Lliurament de claus d'un habitatge comprat amb Conroma",
      vender: "En Herman, de Conroma, preparant la taxació d'un pis",
      alquilar: 'Pis de lloguer gestionat per Conroma',
      'gestion-de-patrimonio': 'Gestió de patrimoni immobiliari amb Conroma',
      reformas: 'Reforma i interiorisme de Conroma en Obras',
    },
  },
})[lang];

// Una foto por servicio (las que ya tenía la home antigua).
const photoOf: Record<string, { src: string; alt: string }> = {
  comprar: { src: '/img/servicios/compra-venta.jpg', alt: t.alts.comprar },
  vender: { src: '/img/equipo/herman-trabajando.jpg', alt: t.alts.vender },
  alquilar: { src: '/img/servicios/alquiler.jpg', alt: t.alts.alquilar },
  'gestion-de-patrimonio': { src: '/img/servicios/gestion-patrimonio.jpg', alt: t.alts['gestion-de-patrimonio'] },
  reformas: { src: '/img/reformas/reforma-07.jpg', alt: t.alts.reformas },
};
---

{
  photos ? (
    <section class="section service-index service-index--photos" id={id}>
      <div class="wrap service-index__grid">
        <div>
          <h2 class="section__title" data-reveal="titulo">{title}</h2>
          <div class="service-index__accordion" data-reveal>
            {list.map((service, index) => (
              <details class="service-index__item" name="servicios" open={index === 0}>
                <summary class="service-index__summary">
                  <h3 class="service-index__name">{service.name}</h3>
                  <Icon name="plus" class="service-index__toggle" />
                </summary>
                <div class="service-index__body">
                  <p class="service-index__text">{service.summary}</p>
                  <a class="arrow-link" href={localizePath(service.href, lang)}>
                    <span class="arrow-link__icon" aria-hidden="true">
                      <Icon name="arrow" />
                    </span>
                    <span class="arrow-link__label">{t.more(service.name)}</span>
                  </a>
                  {photoOf[service.slug] && (
                    <img
                      class="service-index__inline-photo"
                      src={photoOf[service.slug].src}
                      alt={photoOf[service.slug].alt}
                      width="720"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
        <figure class="service-index__figure" aria-hidden="true">
          {list.map((service) =>
            photoOf[service.slug] ? (
              <img
                class="service-index__photo"
                src={photoOf[service.slug].src}
                alt=""
                width="720"
                height="900"
                loading="lazy"
                decoding="async"
              />
            ) : null,
          )}
        </figure>
      </div>
    </section>
  ) : (
    <section class="section service-index">
      <div class="wrap">
        <h2 class="section__title" data-reveal="titulo">{title}</h2>
        <ul class="service-index__list">
          {list.map((service) => (
            <li data-reveal>
              <a class="service-index__row" href={localizePath(service.href, lang)}>
                <h3 class="service-index__name">{service.name}</h3>
                <p class="service-index__text">{service.summary}</p>
                <Icon name="arrow" class="service-index__icon" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
