---
import StoryVideos from '../../islands/StoryVideos';
import { site } from '../../data/site';
import { getLang, strings } from '../../i18n';

const lang = getLang(Astro.url);
const t = strings({
  es: { eyebrow: 'Casos de éxito', title: 'Historias que nos motivan', titleHighlight: 'día a día.', lead: 'Estos son algunos de los casos de éxito y testimonios de clientes de Conroma.' },
  en: { eyebrow: 'Success stories', title: 'Stories that keep us going', titleHighlight: 'every day.', lead: 'Here are some of Conroma’s success stories and client testimonials.' },
  ca: { eyebrow: 'Casos d’èxit', title: 'Històries que ens motiven', titleHighlight: 'dia a dia.', lead: 'Aquests són alguns dels casos d’èxit i testimonis de clients de Conroma.' },
})[lang];

const videos = site.instagramVideos.filter((item) => item.video);
---

{
  videos.length > 0 && (
    <section class="section instagram-videos">
      <div class="wrap">
        <div class="section__head section__head--center" data-reveal>
          <p class="eyebrow">{t.eyebrow}</p>
          <h2 class="section__title">{t.title} <span class="highlight">{t.titleHighlight}</span></h2>
          <p class="section__lead">{t.lead}</p>
        </div>
        <StoryVideos client:visible lang={lang} items={videos.map((item) => ({ url: item.url, label: item.label[lang], video: item.video! }))} />
        <ul class="social-links">
          {
            site.instagram.map((account) => (
              <li class="social-links__item">
                <a class="social-link" href={account.url} rel="noopener" target="_blank" aria-label={`Instagram ${account.handle}`}>
                  <img src="/icons/instagram.svg" alt="" width="22" height="22" />
                </a>
                <span class="social-links__handle">{account.handle}</span>
              </li>
            ))
          }
          {
            site.tiktok && (
              <li class="social-links__item">
                <a class="social-link" href={site.tiktok} rel="noopener" target="_blank" aria-label={`TikTok ${new URL(site.tiktok).pathname.split('/').pop()}`}>
                  <img src="/icons/tiktok.svg" alt="" width="22" height="22" />
                </a>
                <span class="social-links__handle">{new URL(site.tiktok).pathname.split('/').pop()}</span>
              </li>
            )
          }
        </ul>
      </div>
    </section>
  )
}
