---
import { Image } from 'astro:assets';
import type { StoryStep } from '../../data/vender';

interface Props {
  title: string;
  steps: StoryStep[];
  /** Frase que anuncia la sección siguiente. */
  bridge?: string;
  id?: string;
}

const { title, steps, bridge, id } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

{/* Versión base (sin soporte, reduced-motion o móvil): cada paso con su foto encima, completa.
    En escritorio, una foto fija cambia con el paso activo (sections.css + lib/motion/effects.ts). */}
<section class="section story-scroll" id={id}>
  <div class="wrap">
    <h2 class="section__title" data-reveal="titulo">{title}</h2>
    <div class="story-scroll__body">
      <ol class="story-scroll__steps">
        {
          steps.map((step, index) => (
            <li class="story-scroll__step">
              {/* El orden ya lo da la <ol>: el numeral es visual. */}
              <p class="story-scroll__count" aria-hidden="true">
                {pad(index + 1)}
              </p>
              <figure class="story-scroll__inline">
                <Image src={step.image} alt={step.alt} widths={[390, 780]} sizes="(min-width: 60rem) 50vw, 100vw" loading="lazy" />
              </figure>
              <h3 class="story-scroll__title">{step.title}</h3>
              <p class="story-scroll__text">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="story-scroll__stage" aria-hidden="true">
        {
          steps.map((step, index) => (
            <Image
              class="story-scroll__stage-photo"
              src={step.image}
              alt=""
              widths={[780, 1200]}
              sizes="50vw"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
    {bridge && <p class="section__bridge">{bridge}</p>}
  </div>
</section>
