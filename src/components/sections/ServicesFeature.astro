---
import { services } from '../../data/services';

// Iconos de línea por servicio (viewBox 0 0 24 24, trazo), con animación al hover.
const icons: Record<string, string> = {
  // Llave: anilla arriba a la derecha, paletón y dos dientes abajo a la izquierda.
  comprar:
    '<circle cx="16" cy="8" r="3.6"/><path d="M13.4 10.6 4 20"/><path d="m7 17 2 2"/><path d="m10 14 1.9 1.9"/>',
  // Cartel de "se vende": tablero con texto sobre un poste.
  vender:
    '<rect x="3" y="4" width="18" height="10" rx="1.6"/><path d="M7 8h7M7 11h4"/><path d="M12 14v7"/><path d="M9 21h6"/>',
  // Calendario: el alquiler se mide en meses.
  alquilar:
    '<rect x="3" y="5" width="18" height="16" rx="2.2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M7.5 14h3"/>',
  // Dos edificios: varios inmuebles bajo gestión.
  'gestion-de-patrimonio':
    '<rect x="3" y="9" width="7.5" height="12"/><rect x="13" y="4" width="8" height="17"/><path d="M5.6 12.5h2.4M5.6 16h2.4M15.6 7.5h2.8M15.6 11h2.8M15.6 14.5h2.8"/>',
  // Martillo: obra y reforma.
  reformas:
    '<path d="m13.5 3 7.5 7.5-2.5 2.5L11 5.5z"/><path d="m11.8 8.2-8.3 8.3V21h4.5l8.3-8.3"/>',
};
---

<section class="section svcf">
  <div class="wrap">
    <div class="section__head section__head--center" data-reveal>
      <p class="eyebrow">Lo que hacemos</p>
      <h2 class="section__title">Todo lo que pasa alrededor de una casa.</h2>
    </div>
    <ul class="svcf__grid">
      {
        services.map((s) => (
          <li class="svcf__item" data-reveal>
            <a class="svcf__card" href={s.href}>
              <span class="svcf__deco" aria-hidden="true">
                <span class="svcf__icon-box">
                  <svg
                    class={`svcf__icon svcf__icon--${s.slug}`}
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icons[s.slug] ?? ''}
                  />
                </span>
              </span>
              <h3 class="svcf__title">{s.name}</h3>
              <p class="svcf__text">{s.summary}</p>
              <span class="svcf__more">Ver más</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .svcf__grid {
    display: flex;
    flex-wrap: wrap;
    /* center, no space-evenly: así todas las filas mantienen el mismo hueco
       entre tarjetas y la última fila queda centrada como grupo. */
    justify-content: center;
    gap: 18px;
    margin-top: 44px;
  }

  .svcf__item {
    flex: 1 1 100%;
  }

  @media (min-width: 40rem) {
    .svcf__item {
      /* 2 por fila; la última queda repartida por space-evenly */
      flex: 0 1 calc(50% - 9px);
    }
  }

  @media (min-width: 60rem) {
    .svcf__grid {
      gap: 22px;
    }
    .svcf__item {
      /* 3 por fila: (100% - 2 huecos de 22px) / 3 */
      flex: 0 1 calc(33.333% - 14.67px);
    }
  }

  .svcf__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding: 10px 24px 28px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    text-align: center;
    color: var(--color-ink);
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .svcf__card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-2);
  }

  /* Decorador: rejilla enmascarada + caja de icono */
  .svcf__deco {
    position: relative;
    width: 140px;
    height: 128px;
    margin-inline: auto;
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 70%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 70%, transparent 100%);
  }


  .svcf__icon-box {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
    background: var(--color-canvas);
    color: var(--color-ink);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .svcf__card:hover .svcf__icon-box {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .svcf__icon {
    width: 24px;
    height: 24px;
    transform-origin: center;
  }

  .svcf__title {
    margin-top: 2px;
    font-size: var(--text-title);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .svcf__text {
    margin-top: 8px;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 30ch;
  }

  .svcf__more {
    margin-top: 14px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent-deep);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .svcf__card:hover .svcf__more {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .svcf__card:hover .svcf__icon {
      animation-duration: 0.55s;
      animation-timing-function: var(--ease-out);
    }
    .svcf__card:hover .svcf__icon--comprar {
      animation-name: svcf-wiggle;
    }
    .svcf__card:hover .svcf__icon--vender {
      animation-name: svcf-rise;
    }
    .svcf__card:hover .svcf__icon--alquilar {
      animation-name: svcf-pop;
    }
    .svcf__card:hover .svcf__icon--gestion-de-patrimonio {
      animation-name: svcf-rise;
    }
    .svcf__card:hover .svcf__icon--reformas {
      animation-name: svcf-tap;
    }
  }

  @keyframes svcf-wiggle {
    0%, 100% { transform: rotate(0); }
    30% { transform: rotate(-16deg); }
    60% { transform: rotate(8deg); }
  }
  @keyframes svcf-rise {
    0% { transform: translateY(0); }
    45% { transform: translateY(-4px); }
    100% { transform: translateY(0); }
  }
  @keyframes svcf-pop {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.18); }
  }
  @keyframes svcf-tap {
    0%, 100% { transform: rotate(0); }
    35% { transform: rotate(-18deg); }
    70% { transform: rotate(6deg); }
  }
</style>
