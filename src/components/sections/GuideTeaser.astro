---
import { postsIn } from '../../data/blog';
import { getLang, intlLocale, localizePath } from '../../i18n';

interface Props {
  title: string;
  /** Clave de categoría en español (Comprar, Vender, Alquilar). */
  category: string;
  limit?: number;
}

const { title, category, limit = 3 } = Astro.props;
// Solo artículos que existen: si la intención no tiene ninguno, la sección no se pinta.
const lang = getLang(Astro.url);
const list = postsIn(category, lang, limit);
const longDate = new Intl.DateTimeFormat(intlLocale[lang], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' });
---

{
  list.length > 0 && (
    <section class="section guide-teaser">
      <div class="wrap">
        <h2 class="section__title" data-reveal>{title}</h2>
        <ul class="guide-teaser__list">
          {list.map((post) => (
            <li data-reveal>
              <a class="guide-teaser__card" href={localizePath(`/es/blog/${post.slug}/`, lang)}>
                <time class="guide-teaser__date" datetime={post.date}>
                  {longDate.format(new Date(`${post.date}T12:00:00Z`))}
                </time>
                <h3 class="guide-teaser__title">{post.title}</h3>
                <p class="guide-teaser__text">{post.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
