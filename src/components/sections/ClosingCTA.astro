---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { phoneUrl, whatsappUrl, type ContactReason } from '../../lib/links';

interface Props {
  title: string;
  text?: string;
  /** data-origin para GTM (la conversión se mide por la URL wa.me / tel:). */
  origin: string;
  reason?: ContactReason;
  /** Etiqueta corta entre paréntesis sobre el título. */
  kicker?: string;
  /** Foto a sangre de fondo (decorativa). Sin ella, cierre plano. */
  image?: ImageMetadata;
}

const { title, text, origin, reason, kicker, image } = Astro.props;
---

<section class:list={['section closing-cta', image && 'closing-cta--photo']}>
  {
    image && (
      <Image class="closing-cta__photo" src={image} alt="" widths={[390, 780, 1200, 1800]} sizes="100vw" loading="lazy" />
    )
  }
  <div class="wrap closing-cta__inner">
    {kicker && <p class="kicker">{kicker}</p>}
    <h2 class="section__title" data-reveal>{title}</h2>
    {text && <p class="section__lead">{text}</p>}
    <div class="closing-cta__actions">
      <a class="arrow-link" href={whatsappUrl({ reason })} data-contact="whatsapp" data-origin={origin}>
        <span class="arrow-link__icon"><Icon name="whatsapp" /></span>
        <span class="arrow-link__label">Escríbenos por WhatsApp</span>
      </a>
      <a class="closing-cta__call" href={phoneUrl()} data-contact="llamada" data-origin={origin}>
        O llámanos al {site.phoneDisplay}
      </a>
    </div>
    <slot />
  </div>
</section>
