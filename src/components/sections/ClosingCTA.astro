---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { phoneUrl, whatsappUrl, type ContactReason } from '../../lib/links';

interface Props {
  title: string;
  /** Segunda línea del titular, atenuada («Hablemos / de tu piso»). */
  titleMuted?: string;
  text?: string;
  /** data-origin para GTM (la conversión se mide por la URL wa.me / tel:). */
  origin: string;
  reason?: ContactReason;
  /** Foto a sangre de fondo (decorativa). Sin ella, cierre plano. */
  image?: ImageMetadata;
}

const { title, titleMuted, text, origin, reason, image } = Astro.props;
const panelId = `cierre-${origin}`;
---

{/* Cierre: titular en dos tiempos y un círculo que abre el contacto.
    Sin JS (o con reduced-motion) todo se ve a la vez: el paso intermedio es solo mejora. */}
<section
  class:list={['section closing-cta', image && 'closing-cta--photo']}
  data-closing
>
  {
    image && (
      <Image class="closing-cta__photo" src={image} alt="" widths={[390, 780, 1200, 1800]} sizes="100vw" loading="lazy" />
    )
  }
  <div class="wrap closing-cta__inner">
    <div class="closing-cta__stage">
      <div class="closing-cta__intro" data-intro>
        <h2 class="closing-cta__title">
          <span class="closing-cta__line">{title}</span>
          {titleMuted && <span class="closing-cta__line closing-cta__line--muted">{titleMuted}</span>}
        </h2>
        <button class="closing-cta__orb" type="button" aria-expanded="false" aria-controls={panelId} data-orb>
          <span class="visually-hidden">Ver cómo contactar</span>
          <Icon name="arrow" />
        </button>
        {text && <p class="closing-cta__text">{text}</p>}
      </div>

      <div class="closing-cta__panel" id={panelId} data-panel>
        <p class="closing-cta__panel-title">Hablemos</p>
        <div class="closing-cta__pill-row">
          <span class="closing-cta__rule" aria-hidden="true" />
          <a class="closing-cta__pill" href={whatsappUrl({ reason })} data-contact="whatsapp" data-origin={origin}>
            <Icon name="whatsapp" />
            Escríbenos por WhatsApp
          </a>
          <span class="closing-cta__rule" aria-hidden="true" />
        </div>
        <a class="closing-cta__call" href={phoneUrl()} data-contact="llamada" data-origin={origin}>
          O llámanos al {site.phoneDisplay}
        </a>
      </div>
    </div>
    <slot />
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-closing]')) {
    // Con reduced-motion no hay paso intermedio: el contacto queda a la vista.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    const orb = root.querySelector<HTMLButtonElement>('[data-orb]');
    const intro = root.querySelector<HTMLElement>('[data-intro]');
    const panel = root.querySelector<HTMLElement>('[data-panel]');
    if (!orb || !intro || !panel) continue;

    root.classList.add('is-enhanced');
    panel.inert = true;
    orb.addEventListener('click', () => {
      root.classList.add('is-open');
      orb.setAttribute('aria-expanded', 'true');
      intro.inert = true;
      panel.inert = false;
      // El foco sigue al contenido nuevo: el botón de WhatsApp.
      setTimeout(() => panel.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true }), 450);
    });
  }
</script>
