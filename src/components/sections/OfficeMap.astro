---
import Icon from '../Icon.astro';
import OfficeMapLibre from '../../islands/OfficeMapLibre';
import { site } from '../../data/site';
import { formatRating } from '../../lib/format';

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${site.geo?.latitude},${site.geo?.longitude}`;
const rating = site.googleRating;
// Horario compacto (los dos turnos de L-V).
const hours = site.openingHours?.map((s) => `${s.opens}–${s.closes}`).join(' · ');
---

{/* Mapa editorial: mapa sin caja ni sombra (radio 4px) y los datos debajo, sin tarjeta.
    Primario «Cómo llegar» y secundario como texto clicable. */}
{
  site.geo && (
    <section class="section office-map">
      <div class="wrap">
        <h2 class="section__title" data-reveal>Pásate por la oficina</h2>
        <div class="office-map__frame" data-reveal>
          <OfficeMapLibre
            client:only="react"
            latitude={site.geo.latitude}
            longitude={site.geo.longitude}
            label={`${site.legalName} · ${site.address.street}`}
          />
        </div>
        <div class="office-map__panel" data-reveal>
          <div class="office-map__data">
            <p class="office-map__title">{site.address.street}</p>
            <p class="office-map__place">
              {site.address.postalCode} {site.address.locality} · {site.address.region}
            </p>
            {hours && <p class="office-map__place">Lunes a viernes · {hours}</p>}
            {rating && (
              <a class="office-map__rating" href={rating.url} rel="noopener" target="_blank">
                <Icon name="star" class="office-map__star" />
                {formatRating(rating.value)} en Google · {rating.count} reseñas
              </a>
            )}
          </div>
          <div class="office-map__actions">
            <a class="button button--primary button--large" href={directionsUrl} rel="noopener" target="_blank">
              Cómo llegar
            </a>
            <a class="link-cta" href={site.mapsUrl} rel="noopener" target="_blank">
              Ver en Google Maps
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}
