---
import { getLang, strings } from '../../i18n';
import Icon from '../Icon.astro';
import TestimonialCarousel from '../../islands/TestimonialCarousel.tsx';
import { testimonials } from '../../data/testimonials';
import { site } from '../../data/site';
import { formatRating } from '../../lib/format';

interface Props {
  title?: string;
  lead?: string;
  limit?: number;
  /** Banda: surface-2 por defecto; canvas si la sección de al lado ya es surface-2. */
  tone?: 'surface' | 'canvas';
}

const lang = getLang(Astro.url);
const t = strings({
  es: {
    title: 'Lo que dicen nuestros clientes',
    lead: 'Vecinos del Maresme que compraron, vendieron o alquilaron con nosotros.',
    outOf: 'sobre 5 en Google',
    onGoogle: 'en Google',
    reviews: 'reseñas',
  },
  en: {
    title: 'What our clients say',
    lead: 'People from the Maresme who bought, sold or rented with us.',
    outOf: 'out of 5 on Google',
    onGoogle: 'on Google',
    reviews: 'reviews',
  },
  ca: {
    title: 'El que diuen els nostres clients',
    lead: 'Veïns del Maresme que van comprar, vendre o llogar amb nosaltres.',
    outOf: 'sobre 5 a Google',
    onGoogle: 'a Google',
    reviews: 'ressenyes',
  },
})[lang];

const {
  title = t.title,
  lead = t.lead,
  limit = testimonials.length,
  tone = 'surface',
} = Astro.props;
const items = testimonials.slice(0, limit);
const rating = site.googleRating;
---

{/* Dos columnas en escritorio: título, nota de Google y puntos a la izquierda; la reseña a la derecha.
    En móvil: título, reseña y puntos debajo. */}
<section class:list={['section testimonials', tone === 'canvas' && 'testimonials--canvas']}>
  <div class="wrap testimonials__grid" data-reveal>
    <div class="testimonials__head">
      <h2 class="section__title">{title}</h2>
      <p class="testimonials__lead">{lead}</p>
      {
        rating && (
          <a class="testimonials__rating" href={rating.url} rel="noopener" target="_blank">
            <span class="testimonials__stars" role="img" aria-label={`${formatRating(rating.value, lang)} ${t.outOf}`}>
              <Icon name="star" />
              <Icon name="star" />
              <Icon name="star" />
              <Icon name="star" />
              <Icon name="star" />
            </span>
            <span>
              <strong>{formatRating(rating.value, lang)}</strong> {t.onGoogle} · {rating.count} {t.reviews}
            </span>
          </a>
        )
      }
    </div>
    <TestimonialCarousel client:visible testimonials={items} lang={lang} />
  </div>
</section>
