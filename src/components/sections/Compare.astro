---
import type { CompareRow } from '../../data/vender';

interface Props {
  title: string;
  columns: [string, string];
  rows: CompareRow[];
  /** Frase que anuncia la sección siguiente. */
  bridge?: string;
  /** Etiqueta corta entre paréntesis sobre el título. */
  kicker?: string;
}

const { title, columns, rows, bridge, kicker } = Astro.props;
const titleId = `compare-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
// Dos fichas en vez de tabla: en 390 px una tabla de tres columnas no se lee.
const cards = [
  { name: columns[0], us: true, values: rows.map((row) => row.withUs) },
  { name: columns[1], us: false, values: rows.map((row) => row.alone) },
];
---

<section class="section compare" aria-labelledby={titleId}>
  <div class="wrap">
    {kicker && <p class="kicker">{kicker}</p>}
    <h2 class="section__title" id={titleId} data-reveal>{title}</h2>
    <div class="compare__grid">
      {
        cards.map((card) => (
          <article class:list={['compare__card', card.us && 'compare__card--us']} data-reveal>
            <h3 class="compare__name">{card.name}</h3>
            <dl class="compare__list">
              {rows.map((row, index) => (
                <div class="compare__row">
                  <dt>{row.aspect}</dt>
                  <dd>{card.values[index]}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
    {bridge && <p class="section__bridge">{bridge}</p>}
  </div>
</section>
