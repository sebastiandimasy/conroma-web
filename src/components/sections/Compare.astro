---
import Icon from '../Icon.astro';
import type { CompareOption } from '../../data/vender';

interface Props {
  title: string;
  /** Las dos opciones, cada una con a quién le encaja. */
  options: [CompareOption, CompareOption];
  lead?: string;
  /** Frase que anuncia la sección siguiente. */
  bridge?: string;
  /** Etiqueta corta entre paréntesis sobre el título. */
  kicker?: string;
}

const { title, options, lead, bridge, kicker } = Astro.props;
const titleId = `compare-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

{/* Dos mitades sin bordes (la segunda sobre gris): dos opciones válidas; la nuestra, con sus ventajas. */}
<section class="section compare" aria-labelledby={titleId}>
  <div class="wrap compare__head">
    {kicker && <p class="kicker">{kicker}</p>}
    <h2 class="section__title" id={titleId} data-reveal>{title}</h2>
    {lead && <p class="section__lead">{lead}</p>}
  </div>
  <div class="compare__halves">
    {
      options.map((option, index) => (
        <div class:list={['compare__half', index === 0 && 'compare__half--us']}>
          <div class="compare__inner">
            <h3 class="compare__name" data-reveal>{option.title}</h3>
            <div class="compare__groups">
              {option.groups.map((group) => (
                <div class="compare__group">
                  <h4 class="compare__group-title">{group.title}</h4>
                  <ul class="compare__items">
                    {group.items.map((item) => (
                      <li>
                        {/* El ✓ amarillo solo marca a Conroma; la otra opción lleva un punto neutro. */}
                        {index === 0 ? (
                          <span class="compare__check">
                            <Icon name="check" />
                          </span>
                        ) : (
                          <span class="compare__dot" />
                        )}
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
  {bridge && <p class="wrap section__bridge compare__bridge">{bridge}</p>}
</section>
