---
import Icon from '../Icon.astro';
import { propertiesIn } from '../../data/properties';
import { publishedCatalogTowns } from '../../data/towns';

interface Props {
  title: string;
  /** Nivel del título según dónde vaya (h3 dentro de una sección, h2 suelto). */
  as?: 'h2' | 'h3';
  /** Plegada en una fila que se abre (Inicio), para no alargar el scroll. */
  fold?: boolean;
}

const { title, as: Heading = 'h3', fold = false } = Astro.props;

// Pueblos con cartera, de más a menos inmuebles: un enlace por pueblo con su recuento real.
const rows = publishedCatalogTowns
  .map((town) => ({ slug: town.slug, name: town.name, total: propertiesIn(town.slug, 'venta').length }))
  .filter((town) => town.total > 0)
  .sort((a, b) => b.total - a.total);
---

{
  fold ? (
    <details class="town-list town-list--fold" data-reveal>
      <summary class="town-list__summary">
        <Heading class="town-list__title">{title}</Heading>
        <Icon name="plus" class="service-index__toggle" />
      </summary>
      <ul class="town-list__items">
        {rows.map((town) => (
          <li>
            <a class="town-list__link" href={`/es/venta/${town.slug}/`}>
              <span>{town.name}</span>
              <span class="town-list__count">
                {town.total} {town.total === 1 ? 'inmueble' : 'inmuebles'}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ) : (
    <div class="town-list" data-reveal>
      <Heading class={Heading === 'h2' ? 'section__title' : 'town-list__title'}>{title}</Heading>
      <ul class="town-list__items">
        {rows.map((town) => (
          <li>
            <a class="town-list__link" href={`/es/venta/${town.slug}/`}>
              <span>{town.name}</span>
              <span class="town-list__count">
                {town.total} {town.total === 1 ? 'inmueble' : 'inmuebles'}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
