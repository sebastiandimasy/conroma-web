---
import Icon from '../Icon.astro';
import { testimonials } from '../../data/testimonials';
import { site } from '../../data/site';
import { formatRating } from '../../lib/format';

interface Props {
  title: string;
  limit?: number;
}

const { title, limit = testimonials.length } = Astro.props;
const items = testimonials.slice(0, limit);
const rating = site.googleRating;
---

{/* Reseñas reales en texto (Google y las IA las leen), sin carrusel. */}
<section class="section quote-list">
  <div class="wrap">
    <h2 class="section__title" data-reveal>{title}</h2>
    <ul class="quote-list__items">
      {
        items.map((item) => (
          <li class="quote-list__item" data-reveal>
            <blockquote>
              <p class="quote-list__text">«{item.text}»</p>
            </blockquote>
            <p class="quote-list__by">
              <strong>{item.author}</strong> · {item.context}
            </p>
          </li>
        ))
      }
    </ul>
    {
      rating && (
        <a class="arrow-link quote-list__source" href={rating.url} rel="noopener" target="_blank">
          <span class="arrow-link__icon" aria-hidden="true"><Icon name="arrow" /></span>
          <span class="arrow-link__label">
            Ver las {rating.count} reseñas en Google ({formatRating(rating.value)} sobre 5)
          </span>
        </a>
      )
    }
  </div>
</section>
