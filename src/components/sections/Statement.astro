---
interface Props {
  text: string;
}

const { text } = Astro.props;
// Cada palabra va en su <span>: GSAP la enciende al cruzar la pantalla (lib/motion/effects.ts).
const words = text.split(' ');
---

{/* Respuesta corta justo bajo el hero: la primera frase que leen Google y las IA (el texto va entero en el HTML). */}
<section class="section statement">
  <div class="wrap">
    <p class="statement__text">
      {
        words.map((word, i) => (
          <>
            <span class="statement__word">
              {word}
            </span>
            {/* Sin espacio tras la última palabra: en Chrome ese espacio estira el último renglón justificado. */}
            {i < words.length - 1 && ' '}
          </>
        ))
      }
    </p>
  </div>
</section>
