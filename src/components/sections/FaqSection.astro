---
import Faq from '../Faq.astro';
import type { FaqItem } from '../../data/faq';

interface Props {
  title?: string;
  items: FaqItem[];
  /** Etiqueta corta entre paréntesis sobre el título. */
  kicker?: string;
}

const { title = 'Preguntas frecuentes', items, kicker } = Astro.props;
---

<section class="section faq-section" id="preguntas">
  <div class="wrap faq-section__inner">
    <div>
      {kicker && <p class="kicker">{kicker}</p>}
      <h2 class="section__title" data-reveal>{title}</h2>
    </div>
    <div class="faq-section__list">
      <Faq items={items} name="preguntas" />
    </div>
  </div>
</section>
