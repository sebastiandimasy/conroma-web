---
import Faq from '../Faq.astro';
import type { FaqItem } from '../../data/faq';
import { whatsappUrl, type ContactReason } from '../../lib/links';
import { getLang, strings } from '../../i18n';

interface Props {
  title?: string;
  items: FaqItem[];
  /** Frase corta bajo el título. */
  lead?: string;
  /** data-origin para GTM; si se pasa, sale el bloque «¿Te queda alguna duda?» con WhatsApp. */
  origin?: string;
  reason?: ContactReason;
}

const lang = getLang(Astro.url);
const t = strings({
  es: {
    title: 'Preguntas frecuentes',
    contactTitle: '¿Te queda alguna duda?',
    contactText: 'Escríbenos y te la resolvemos.',
    contactLink: 'Preguntar por WhatsApp',
  },
  en: {
    title: 'Frequently asked questions',
    contactTitle: 'Still got a question?',
    contactText: 'Message us and we’ll answer it.',
    contactLink: 'Ask on WhatsApp',
  },
  ca: {
    title: 'Preguntes freqüents',
    contactTitle: 'Et queda algun dubte?',
    contactText: 'Escriu-nos i te’l resolem.',
    contactLink: 'Pregunta per WhatsApp',
  },
})[lang];

const { title = t.title, items, lead, origin, reason } = Astro.props;
---

{/* Columna estrecha y centrada: filas suaves que se abren, y al final una salida por WhatsApp. */}
<section class="section faq-section" id="preguntas">
  <div class="wrap faq-section__inner">
    <div class="faq-section__head">
      <h2 class="section__title" data-reveal>{title}</h2>
      {lead && <p class="section__lead">{lead}</p>}
    </div>
    <div class="faq-section__list">
      <Faq items={items} name="preguntas" />
    </div>
    {
      origin && (
        <div class="faq-section__contact">
          <p class="faq-section__contact-title">{t.contactTitle}</p>
          <p class="faq-section__contact-text">{t.contactText}</p>
          <a class="button button--ghost" href={whatsappUrl(lang, { reason })} data-contact="whatsapp" data-origin={origin}>
            {t.contactLink}
          </a>
        </div>
      )
    }
  </div>
</section>
