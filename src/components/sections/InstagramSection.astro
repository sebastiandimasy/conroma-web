---
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { getLang, strings } from '../../i18n';

const lang = getLang(Astro.url);
const t = strings({
  es: { eyebrow: 'Síguenos el día a día', title: 'Cada casa es una historia. Te las contamos en', open: 'Abrir en Instagram' },
  en: { eyebrow: 'Follow us day to day', title: 'Every home has a story. We tell them on', open: 'Open on Instagram' },
  ca: { eyebrow: 'Segueix-nos el dia a dia', title: 'Cada casa és una història. Te les expliquem a', open: 'Obre a Instagram' },
})[lang];
---

<section class="section instagram">
  <div class="wrap">
    <div class="section__head section__head--center" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section__title">{t.title} <span class="highlight">Instagram.</span></h2>
    </div>
    <ul class="instagram__grid">
      {
        site.instagram.map((account) => (
          <li data-reveal>
            <a class="card feature instagram__card" href={account.url} rel="noopener" target="_blank">
              <h3 class="feature__title">{account.handle}</h3>
              <p class="feature__text">{account.about[lang]}</p>
              <span class="services__more">
                {t.open}
                <Icon name="arrow" class="link-list__arrow" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
