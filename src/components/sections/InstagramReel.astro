---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getLang, strings } from '../../i18n';

interface Props {
  /** Archivo en public/video/, sin extensión. */
  file: string;
  title: string;
  poster?: ImageMetadata;
}

const { file, title, poster } = Astro.props;
const lang = getLang(Astro.url);
const t = strings({
  es: { play: (name: string) => `Reproducir el vídeo «${name}»`, note: '' },
  en: { play: (name: string) => `Play the video “${name}”`, note: 'Video in Spanish' },
  ca: { play: (name: string) => `Reprodueix el vídeo «${name}»`, note: 'Vídeo en castellà' },
})[lang];
const posterSrc = poster ? (await getImage({ src: poster, width: 540, format: 'jpg' })).src : undefined;
---

{/* Vídeo propio (MP4 en public/video/) dentro de un marco con margen y esquinas redondeadas,
    sin la interfaz de Instagram. No se descarga hasta pulsar play (preload="none"). */}
<figure class="reel-embed" data-reel>
  <div class="reel-embed__stage">
    <video class="reel-embed__video" src={`/video/${file}.mp4`} poster={posterSrc} preload="none" playsinline aria-label={title}></video>
    <button type="button" class="reel-embed__play" aria-label={t.play(title)}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"></path></svg>
    </button>
  </div>
  <figcaption class="reel-embed__caption">{title}{t.note && ` · ${t.note}`}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((figure) => {
    const video = figure.querySelector('video');
    const button = figure.querySelector('button');
    if (!video || !button) return;
    button.addEventListener('click', () => {
      video.controls = true;
      button.hidden = true;
      void video.play().catch(() => {});
    });
  });
</script>
