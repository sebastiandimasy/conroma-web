---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  poster?: ImageMetadata;
}

const { id, title, poster } = Astro.props;
const url = `https://www.instagram.com/reel/${id}/`;
---

{/* Reel de Instagram en vivo dentro del artículo. El iframe carga en diferido (al acercarse al
    viewport); mientras, se ve la portada del vídeo, guardada en la web. */}
<figure class="reel-embed">
  <div class="reel-embed__stage">
    {poster && <Image class="reel-embed__poster" src={poster} alt="" widths={[360]} sizes="360px" loading="lazy" />}
    <iframe
      class="reel-embed__frame"
      src={`${url}embed/`}
      title={`Vídeo de Instagram: ${title}`}
      loading="lazy"
      allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
      allowfullscreen></iframe>
  </div>
  <figcaption class="reel-embed__caption">
    «{title}», en nuestro Instagram. <a href={url} target="_blank" rel="noopener">Abrir en Instagram</a>
  </figcaption>
</figure>
