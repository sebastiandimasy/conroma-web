---
import StatCounters from '../../islands/StatCounters';
import { site } from '../../data/site';
import { getListings } from '../../data/properties';

// Solo cifras comprobables: las reseñas de Google (con fecha en site.ts), los años que
// lleva abierta la agencia, los idiomas en los que se atiende y la cartera real.
// Nada redondeado "a ojo": si no se puede enseñar la fuente, no va aquí.
const catalog = getListings();

const stats = [
  { target: site.googleRating?.count ?? 0, label: 'reseñas en Google' },
  { target: site.yearsActive ?? 0, label: 'años en el Alt Maresme' },
  { target: catalog.length, label: 'inmuebles en cartera' },
].filter((stat) => stat.target > 0);
---

<section class="section contador">
  <div class="wrap contador__inner">
    <div class="section__head section__head--center" data-reveal>
      <p class="eyebrow">Gente que ya confía</p>
      <h2 class="section__title">Nos encanta estar en el <span class="highlight">principio de cada historia</span></h2>
    </div>
    <div data-reveal>
      <StatCounters client:visible stats={stats} />
    </div>
    <p class="contador__cta" data-reveal>
      <a class="button button--primary button--large" href="/es/gestion-de-patrimonio/">Impulsa tu patrimonio</a>
    </p>
  </div>
</section>
