---
import Icon from '../Icon.astro';
import Logo from '../Logo.astro';
import SavedLink from '../../islands/SavedLink';
import { site } from '../../data/site';
import { mainNav } from '../../data/nav';
import { whatsappUrl } from '../../lib/links';
import type { IconName } from '../../lib/icons';

const links = mainNav;
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/es/' && current.startsWith(href));

// Dock móvil: Inicio + el nav sin Blog (lista propia; no altera el nav de escritorio).
// El dock no es el menú: son las cinco cosas que alguien viene a hacer. Con siete
// entradas a 390 px las etiquetas se tocaban y los objetivos bajaban de 44 px.
// "Empresa" y "Equipo" siguen en la cabecera y en el pie.
const dockLinks: { label: string; href: string }[] = [
  { label: 'Inicio', href: '/es/' },
  { label: 'Pisos', href: '/es/venta/' },
  { label: 'Vender', href: '/es/vender/' },
  { label: 'Alquilar', href: '/es/alquilar/' },
  { label: 'Contacto', href: '/es/contacto/' },
];

const dockIcons: Record<string, IconName> = {
  Inicio: 'home',
  Pisos: 'search',
  Comprar: 'search',
  Vender: 'tag',
  Alquilar: 'key',
  Contacto: 'phone',
  Empresa: 'building',
  Equipo: 'users',
};

---

<header class="site-header liquid-glass" data-site-header>
  <div class="wrap site-header__bar">
    <a class="brand-lock" href="/es/" aria-label={`${site.legalName}, inicio`}>
      <Logo class="brand-lock__mark" size={32} />
    </a>
    <nav class="site-header__nav" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            class:list={['site-header__link', { 'is-active': isActive(link.href) }]}
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="site-header__group">
      <SavedLink client:idle className="button button--ghost icon-button saved-link" />
      <button class="button button--ghost icon-button" type="button" aria-label="Cambiar entre tema claro y oscuro" data-theme-toggle>
        <Icon name="moon" class="icon-button__icon icon-button__icon--moon" />
        <Icon name="sun" class="icon-button__icon icon-button__icon--sun" />
      </button>
      {/* WhatsApp, no "Valorar mi piso": la valoración ya tiene su sitio en el nav
          ("Vender") y en el dock móvil, así que el CTA la duplicaba desde la esquina
          menos alcanzable. WhatsApp, en cambio, no estaba en ninguna otra parte de la
          cabecera — y es el canal que la web antigua no ofrecía.
          data-contact / data-origin: GTM mide la conversión por la URL del enlace. */}
      <a
        class="button button--primary site-header__cta"
        href={whatsappUrl({ reason: 'general' })}
        data-contact="whatsapp"
        data-origin="cabecera"
        aria-label="Escríbenos por WhatsApp"
      >
        <Icon name="whatsapp" class="button__icon" />
        <span class="site-header__cta-text">Escríbenos</span>
      </a>
    </div>
  </div>
</header>

<nav class="mobile-dock glass glass--thick" aria-label="Navegación principal">
  {
    dockLinks.map((link) => (
      <a
        class:list={['mobile-dock__link', { 'is-active': isActive(link.href) }]}
        href={link.href}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        <Icon name={dockIcons[link.label]} />
        <span>{link.label}</span>
      </a>
    ))
  }
</nav>

<script>
  function initHeaderControls() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    toggle?.addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('conroma:tema', next);
      } catch {
        return;
      }
    });
  }
  initHeaderControls();
</script>
