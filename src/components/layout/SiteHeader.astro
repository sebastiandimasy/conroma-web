---
import Icon from '../Icon.astro';
import Logo from '../Logo.astro';
import SavedLink from '../../islands/SavedLink';
import { site } from '../../data/site';
import { mainNav } from '../../data/nav';
import type { IconName } from '../../lib/icons';

const links = mainNav;
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/es/' && current.startsWith(href));

// Icono de cada enlace del menú; el dock móvil usa los mismos enlaces que el de escritorio.
const dockIcons: Record<string, IconName> = {
  Comprar: 'home',
  Vender: 'tag',
  Alquilar: 'key',
  Empresa: 'building',
  Equipo: 'users',
  Blog: 'newspaper',
};

---

<header class="site-header liquid-glass" data-site-header>
  <div class="wrap site-header__bar">
    <a class="brand-lock" href="/es/" aria-label={`${site.legalName}, inicio`}>
      <Logo class="brand-lock__mark" size={32} />
    </a>
    <nav class="site-header__nav" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            class:list={['site-header__link', { 'is-active': isActive(link.href) }]}
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="site-header__group">
      <SavedLink client:idle className="button button--ghost icon-button saved-link" />
      <button class="button button--ghost icon-button" type="button" aria-label="Cambiar entre tema claro y oscuro" data-theme-toggle>
        <Icon name="moon" class="icon-button__icon icon-button__icon--moon" />
        <Icon name="sun" class="icon-button__icon icon-button__icon--sun" />
      </button>
      <a class="button button--primary site-header__cta" href="/es/valoracion/">Valorar mi piso</a>
    </div>
  </div>
</header>

<nav class="mobile-dock glass glass--thick" aria-label="Navegación principal">
  {
    links.map((link) => (
      <a
        class:list={['mobile-dock__link', { 'is-active': isActive(link.href) }]}
        href={link.href}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        <Icon name={dockIcons[link.label]} />
        <span>{link.label}</span>
      </a>
    ))
  }
</nav>

<script>
  function initHeaderControls() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    toggle?.addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('conroma:tema', next);
      } catch {
        return;
      }
    });
  }
  initHeaderControls();
</script>
