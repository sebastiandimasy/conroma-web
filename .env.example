
# Supabase (base de datos oficial de Conroma)
# Públicas (navegador/panel): seguras de exponer, protegidas por RLS.
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secreta: SOLO en el Worker (wrangler secret put SUPABASE_SERVICE_ROLE_KEY). NUNCA en el navegador ni en el repo.
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...

# Sincronización del inventario desde el feed de Habitatsoft "Enlace Web 2.0" (opcional).
# SIN prefijo PUBLIC_: solo se usa en el build (server), nunca llega al navegador.
# Si está, cada `npm run build` lee los pisos del feed; si no, usa properties.real.json.
# HABITATSOFT_FEED_URL="https://.../feed.xml"
